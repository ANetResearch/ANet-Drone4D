{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bench/1/frames.v1.schema.json",
  "title": "Frame range container header (d3frames.v1)",
  "description": "AWR-17 §18.8.2 (BN-51; contracts 1.3.0, d1 V0.3). Content-Type application/x-d3frames. This schema validates the header JSON; x-layout gives the container. Payloads are the raw.mcap message bytes (the bytes the agent received, ADR-163). Missing seqs take no record. Limits: seq_to - seq_from + 1 <= 300 * stride and response <= 64 MiB, otherwise 422 698.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "uav_id": {
      "type": "string"
    },
    "sensor_id": {
      "type": "string"
    },
    "encoding": {
      "type": "string"
    },
    "codec": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "seq_from": {
      "type": "integer",
      "minimum": 0
    },
    "seq_to": {
      "type": "integer",
      "minimum": 0
    },
    "stride": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "run_id",
    "uav_id",
    "sensor_id",
    "encoding",
    "codec",
    "n",
    "seq_from",
    "seq_to",
    "stride"
  ],
  "x-layout": {
    "content_type": "application/x-d3frames",
    "magic": "D3FR",
    "header": [
      [
        "magic",
        "u8[4]"
      ],
      [
        "version",
        "u16"
      ],
      [
        "flags",
        "u16"
      ],
      [
        "header_len",
        "u32"
      ],
      [
        "header_json",
        "utf8[header_len]"
      ]
    ],
    "version": 1,
    "record": {
      "fields": [
        [
          "seq",
          "u32"
        ],
        [
          "t_ns",
          "i64"
        ],
        [
          "len",
          "u32"
        ],
        [
          "sha256",
          "u8[32]"
        ],
        [
          "payload",
          "u8[len]"
        ]
      ],
      "fixed_bytes": 48
    },
    "trailer": [
      [
        "sha256",
        "u8[32]"
      ]
    ],
    "trailer_covers": "header and all record bytes",
    "limits": {
      "max_frames_per_stride": 300,
      "max_bytes": 67108864,
      "reason": 698
    }
  }
}
