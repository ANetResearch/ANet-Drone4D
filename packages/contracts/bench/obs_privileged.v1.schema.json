{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bench/1/obs_privileged.v1.schema.json",
  "title": "Privileged observation (drone4d.bench.obs_privileged.v1)",
  "description": "M26 §7.11 (contracts 1.3.0, d1 V0.3). L0 and T0 only, privileged runs only: the encoder refuses ranked = true or split = test (662). obs.v1 plus oracle and features.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "obs": {
      "$ref": "obs.v1.schema.json#/$defs/Observation"
    },
    "inbox": {
      "type": "array",
      "items": {
        "$ref": "obs.v1.schema.json#/$defs/Message"
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actor_id": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "pos_enu_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "vel_enu_mps": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "yaw_rad": {
                "type": "number"
              },
              "state": {
                "type": "string"
              }
            },
            "required": [
              "actor_id",
              "class",
              "pos_enu_m",
              "vel_enu_mps",
              "yaw_rad",
              "state"
            ]
          }
        },
        "true_pose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pos_enu_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "q_wb_xyzw": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "pos_enu_m",
            "q_wb_xyzw"
          ]
        }
      },
      "required": [
        "actors",
        "true_pose"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sensor_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "n": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "uv_px": {
            "x-awr-bin": "f32le[2n]",
            "description": "Pixel coordinates (msgpack bin, little-endian; length given by the counts in the same object)"
          },
          "xyz_cam_m": {
            "x-awr-bin": "f32le[3n]",
            "description": "Camera frame points (msgpack bin, little-endian; length given by the counts in the same object)"
          },
          "ids": {
            "x-awr-bin": "u32le[n]",
            "description": "Track ids (msgpack bin, little-endian; length given by the counts in the same object)"
          }
        },
        "required": [
          "sensor_id",
          "seq",
          "n",
          "uv_px",
          "xyz_cam_m",
          "ids"
        ]
      },
      "description": "T0"
    }
  },
  "required": [
    "obs",
    "inbox",
    "oracle"
  ]
}
