{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bench/1/act.v1.schema.json",
  "title": "Agent action (drone4d.bench.act.v1)",
  "description": "AWR-05 §8.1, M26 §7.5 (contracts 1.3.0, d1 V0.3). k must equal the observation k; an absent nav keeps the previous command; tau_ms only when decision.mode = per_step. Report types per event type (v1.3) are a runtime whitelist (M23 report_types).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.bench.act.v1"
    },
    "k": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "nav": {
      "$ref": "#/$defs/NavCmd"
    },
    "gimbal": {
      "$ref": "#/$defs/GimbalCmd"
    },
    "zoom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZoomCmd"
      }
    },
    "sensor_mode": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SensorModeCmd"
      }
    },
    "msgs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutMessage"
      }
    },
    "report": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Report"
      }
    },
    "tau_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "schema",
    "k"
  ],
  "$defs": {
    "NavCmd": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "null encodes NaN (axis not controlled)",
          "properties": {
            "mode": {
              "const": "velocity"
            },
            "vel_mps": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minItems": 3,
              "maxItems": 3
            },
            "yaw_rate_rps": {
              "type": [
                "number",
                "null"
              ]
            },
            "frame": {
              "enum": [
                "world",
                "body"
              ]
            },
            "hold_alt": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "vel_mps",
            "frame"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "goto"
            },
            "pos_enu_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "speed_mps": {
              "type": "number"
            },
            "yaw_deg": {
              "type": "number"
            },
            "accept_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "mode",
            "pos_enu_m"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "hover"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "takeoff"
            },
            "alt_agl_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "mode",
            "alt_agl_m"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "land"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "P1",
          "properties": {
            "mode": {
              "const": "orbit"
            },
            "center_enu_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "alt_m": {
              "type": "number"
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "speed_mps": {
              "type": "number"
            },
            "cw": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "center_enu_m",
            "alt_m",
            "radius_m",
            "speed_mps",
            "cw"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "P1",
          "properties": {
            "mode": {
              "const": "path"
            },
            "waypoints_enu_m": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 1,
              "maxItems": 64
            },
            "speed_mps": {
              "type": "number"
            }
          },
          "required": [
            "mode",
            "waypoints_enu_m",
            "speed_mps"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "P1",
          "properties": {
            "mode": {
              "const": "rtl"
            }
          },
          "required": [
            "mode"
          ]
        }
      ],
      "description": "Positions are in the estimated frame"
    },
    "GimbalCmd": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sensor_id": {
              "type": "string"
            },
            "mode": {
              "const": "angles"
            },
            "pitch_deg": {
              "type": "number"
            },
            "yaw_deg": {
              "type": "number"
            }
          },
          "required": [
            "sensor_id",
            "mode",
            "pitch_deg",
            "yaw_deg"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sensor_id": {
              "type": "string"
            },
            "mode": {
              "const": "look_at"
            },
            "target_enu_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "sensor_id",
            "mode",
            "target_enu_m"
          ]
        }
      ]
    },
    "ZoomCmd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "type": "string"
        },
        "zoom_x": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "sensor_id",
        "zoom_x"
      ]
    },
    "SensorModeCmd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "sensor_id",
        "mode",
        "active"
      ]
    },
    "OutMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dst": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "maxLength": 64
        },
        "payload": {
          "x-awr-bin": "u8[<=65536]",
          "description": "Message body (msgpack bin, little-endian; length given by the counts in the same object)"
        }
      },
      "required": [
        "dst",
        "topic",
        "payload"
      ]
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "description": "Must be in brief.report_vocab and the task report_types (663 report_type otherwise)"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "track_id": {
                "type": "string"
              },
              "appearance": {
                "type": "object"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "uav": {
                      "type": "string"
                    },
                    "sensor": {
                      "type": "string"
                    },
                    "frame_seq": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "bbox_xywh": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "point_xy": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "det_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{16}$"
                    }
                  },
                  "required": [
                    "uav",
                    "sensor",
                    "frame_seq"
                  ],
                  "oneOf": [
                    {
                      "required": [
                        "bbox_xywh"
                      ]
                    },
                    {
                      "required": [
                        "point_xy"
                      ]
                    },
                    {
                      "required": [
                        "det_id"
                      ]
                    }
                  ],
                  "description": "Exactly one of bbox_xywh, point_xy, det_id"
                },
                "minItems": 1
              }
            },
            "required": [
              "track_id",
              "evidence"
            ]
          },
          "minItems": 1
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t_start_ns": {
              "type": "integer"
            },
            "t_end_ns": {
              "type": "integer"
            }
          },
          "required": [
            "t_start_ns",
            "t_end_ns"
          ]
        },
        "position_enu_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "participants",
        "window"
      ]
    }
  }
}
