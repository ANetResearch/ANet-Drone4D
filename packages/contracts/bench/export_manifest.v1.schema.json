{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bench/1/export_manifest.v1.schema.json",
  "title": "Dataset export manifest derived/export_manifest.json (drone4d.bench.export_manifest.v1)",
  "description": "M27-FR-066, FR-067, FR-068, FR-072, FR-073, FR-074; M27 §7.6; D3-AC-63 (contracts 1.3.0, d1 V0.3). One manifest per run under runs/<run_id>/derived/. Lists every exported file with its sha256, the source raw.mcap and truth file hashes, the quantisation of each derived format, licence and attribution inherited from the world package, and the generation-tool statement. Only dev-split, non-evaluation runs are exportable (691 otherwise). Apart from generated_unix_ns the document is byte-identical for the same raw.mcap, truth file and exporter version (FR-074).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exporter", "generated_unix_ns", "run_id", "experiment_id", "event_id", "world_id", "split", "formats", "layers", "source",
               "quantization", "license", "generation", "retention", "counts", "skipped", "files"],
  "properties": {
    "schema": {"const": "drone4d.bench.export_manifest.v1"},
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "contracts_version"],
      "properties": {
        "name": {"const": "awr.bench.export"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contracts_version": {"type": "string"}
      }
    },
    "generated_unix_ns": {"type": "integer", "minimum": 0, "description": "The only field excluded from export determinism (FR-074)"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string"},
    "event_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "split": {"const": "dev"},
    "formats": {"type": "array", "items": {"enum": ["files", "bag"]}, "uniqueItems": true, "minItems": 1},
    "layers": {"type": "array", "items": {"enum": ["obs", "run", "truth"]}, "uniqueItems": true, "minItems": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_mcap_sha256", "raw_mcap_bytes", "frames_idx_sha256", "truth_mcap_sha256", "run_manifest_sha256", "evaluation_sha256"],
      "properties": {
        "raw_mcap_sha256": {"$ref": "#/$defs/sha256"},
        "raw_mcap_bytes": {"type": "integer", "minimum": 0},
        "frames_idx_sha256": {"$ref": "#/$defs/sha256"},
        "truth_mcap_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "run_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "quantization": {
      "type": "object",
      "description": "Per derived kind: how the file encodes the archived value (lossless kinds state lossless = true)",
      "additionalProperties": {
        "type": "object",
        "required": ["encoding", "lossless"],
        "properties": {"encoding": {"type": "string"}, "lossless": {"type": "boolean"}}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "dataset", "citation", "url", "notice", "redistribution", "derivedFrom", "attribution", "modification", "missing"],
      "properties": {
        "complete": {"type": "boolean"},
        "dataset": {"type": ["string", "null"], "description": "Licence of the world package source data (e.g. CC-BY-4.0); renderings are derived works"},
        "citation": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "notice": {"type": ["string", "null"]},
        "redistribution": {"type": ["boolean", "null"], "description": "world.json dataset.redistribution fact record (ADR-034)"},
        "derivedFrom": {"type": "array", "items": {"type": "object"}},
        "attribution": {"type": "object", "properties": {"en": {"type": ["string", "null"]}, "zh": {"type": ["string", "null"]}}},
        "modification": {"type": "string"},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "statement", "appearance", "tools", "versions"],
      "properties": {
        "synthetic": {"const": true},
        "statement": {"type": "object", "required": ["zh", "en"], "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}},
        "appearance": {"type": "string"},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "role"],
            "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "role": {"type": "string"}}
          }
        },
        "versions": {"type": "object", "description": "run_manifest.versions (M27-FR-008)"}
      }
    },
    "retention": {
      "type": "object",
      "description": "Derived-artifact retention class per format (M27-FR-058: bag transient 7 d, files standard 30 d by default; v1.6 (B26): an export request may set transient or standard for the formats it generates)",
      "additionalProperties": {"enum": ["transient", "standard", "pinned"]}
    },
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "properties": {"what": {"type": "string"}, "why": {"type": "string"}, "n": {"type": "integer", "minimum": 0}}
      }
    },
    "files": {
      "type": "array",
      "description": "Sorted by path; paths are relative to derived/",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "layer", "kind", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"},
          "format": {"enum": ["files", "bag"]},
          "layer": {"enum": ["obs", "run", "truth"]},
          "kind": {"enum": ["rgb", "depth_log16", "thermal_u16", "thermal_agc", "seg_instance", "seg_semantic", "lidar", "state", "messages", "actions", "reports", "bag"],
                   "description": "v1.6 (B26, additive): thermal_u16 = radiometric_u16 thermal frame as PNG16 in 0.01 K per LSB, decoded from the delivered temp_ck bytes (source_sha256); thermal_agc = agc_jpeg thermal preview bytes as archived (dev runs only)"},
          "uav": {"type": "string"},
          "sensor": {"type": "string"},
          "seq": {"type": "integer", "minimum": 0},
          "t_ns": {"type": "integer"},
          "n": {"type": "integer", "minimum": 0, "description": "Lines (jsonl) or messages (bag)"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "source_sha256": {"$ref": "#/$defs/sha256", "description": "sha256 of the archived payload this file was derived from (equal to sha256 for byte-identical kinds)"},
          "stats": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
