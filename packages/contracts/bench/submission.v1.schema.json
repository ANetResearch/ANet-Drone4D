{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bench/1/submission.v1.schema.json",
  "title": "Internal submission (drone4d.bench.submission.v1)",
  "description": "AWR-17 §18.23 and §18.24 (contracts 1.3.0, d1 V0.3): internal submissions (invited members and above); public submissions are withdrawn. The request carries track, lanes?, image_digest, entry and notes; the server adds the rest. No composite value.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.bench.submission.v1"
    },
    "submission_id": {
      "type": "string"
    },
    "track": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "cmd"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "state": {
      "enum": [
        "RECEIVED",
        "SCANNING",
        "VALIDATING",
        "EVALUATING",
        "SCORING",
        "DONE",
        "REJECTED",
        "FAILED",
        "WITHDRAWN"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "board"
      ]
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "name": {
          "type": "string"
        },
        "detail": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "name"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string"
              },
              "metrics": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ec": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "ci95": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "tie_group": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "repeat_delta": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "value",
                      "ci95"
                    ]
                  },
                  "eu": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "ci95": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "tie_group": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "repeat_delta": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "value",
                      "ci95"
                    ]
                  },
                  "ao": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "ci95": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "tie_group": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "repeat_delta": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "value",
                      "ci95"
                    ]
                  },
                  "ce": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "ci95": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "tie_group": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "repeat_delta": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "value",
                      "ci95"
                    ]
                  }
                },
                "required": []
              },
              "dominance_tier": {
                "type": "integer",
                "minimum": 1
              },
              "runs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "valid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "invalid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "platform_rerun": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "total",
                  "valid",
                  "invalid"
                ]
              },
              "status": {
                "type": "string"
              },
              "composite": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "lane",
              "metrics",
              "runs"
            ]
          }
        }
      },
      "required": [
        "lanes"
      ]
    }
  },
  "required": [
    "track",
    "image_digest",
    "entry"
  ]
}
