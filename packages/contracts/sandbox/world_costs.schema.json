{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/sandbox/1/world_costs.schema.json",
  "title": "awr.sandbox.world_costs.v1 (configs/sandbox/world_costs.json)",
  "description": "World cost table for weighted admission (AWR-04 §4.4.2; M17 §6.2 WorldCost). Generated by the M16 harness, consumed by sandbox-pool; initial values are conservative and frozen by ADR after emax measurement (D2-MS5).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.sandbox.world_costs.v1"
    },
    "generator": {
      "type": "string"
    },
    "generated_unix_ns": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$",
      "description": "UNIX time in ns as a decimal string (AWR-17 §1.3)"
    },
    "host": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cpu_model": {
          "type": "string"
        },
        "cores": {
          "type": "integer",
          "minimum": 0
        },
        "mem_mb": {
          "type": "number",
          "minimum": 0,
          "unit": "MiB"
        }
      }
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "world": {
            "$ref": "../../world/1/common.schema.json#/$defs/id"
          },
          "world_class": {
            "enum": [
              "S",
              "L"
            ]
          },
          "anon_mb": {
            "type": "number",
            "minimum": 0,
            "unit": "MiB"
          },
          "ws_mb": {
            "type": "number",
            "minimum": 0,
            "unit": "MiB"
          },
          "c0": {
            "type": "number",
            "minimum": 0,
            "description": "core; x1 full-load cores per session prior (core-seconds per second)"
          },
          "available": {
            "type": "boolean"
          },
          "measured": {
            "type": "boolean"
          },
          "src": {
            "type": "string"
          }
        },
        "required": [
          "world",
          "world_class",
          "anon_mb",
          "ws_mb",
          "c0",
          "available"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "worlds"
  ]
}
