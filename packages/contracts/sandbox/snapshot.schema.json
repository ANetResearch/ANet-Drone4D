{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/sandbox/1/snapshot.schema.json",
  "title": "awr.sandbox.snapshot.v1 (session configuration snapshot)",
  "description": "Configuration only (AWR-04 §4.6; AWR-17 §17.4.5): tasks as definitions and parameters, no run state; <= 256 KiB on export, <= 512 KiB decompressed on import; world_id must match the session (512, why world_mismatch).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.sandbox.snapshot.v1"
    },
    "contracts": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "world_id": {
      "$ref": "../../world/1/common.schema.json#/$defs/id"
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "type": "string",
          "description": "ISO 8601 UTC"
        },
        "tz": {
          "type": "string",
          "description": "IANA time zone"
        }
      },
      "required": [
        "start_utc",
        "tz"
      ]
    },
    "acoustic_bg": {
      "enum": [
        "rural",
        "suburban",
        "urban"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "type": "object"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "../../vehicle/1/clone.schema.json"
      },
      "maxItems": 8
    },
    "nests": {
      "type": "array",
      "items": {
        "$ref": "../../tasking/1/nest.schema.json"
      },
      "maxItems": 4
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "../../world/1/common.schema.json#/$defs/slug"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          },
          "nest_id": {
            "oneOf": [
              {
                "$ref": "../../world/1/common.schema.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "home_enu_m": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "yaw_rad": {
            "type": "number",
            "unit": "rad"
          },
          "initial_soc": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sensors": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,24}$"
                    },
                    "type": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "limits_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "lights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nav": {
                "type": "boolean"
              },
              "strobe": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "model_id"
        ],
        "description": "vehicle instance configuration (AWR-17 §17.6.3 POST body; AWR-20 §7.7)"
      },
      "maxItems": 12
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "../../target/1/target.schema.json#/$defs/create_request"
      },
      "maxItems": 30
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "../../tasking/1/task.schema.json#/$defs/request"
      },
      "maxItems": 6
    },
    "created_unix_ns": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$",
      "description": "UNIX time in ns as a decimal string (AWR-17 §1.3)"
    }
  },
  "required": [
    "schema",
    "contracts",
    "world_id",
    "calendar",
    "seed",
    "nests",
    "vehicles",
    "targets",
    "tasks"
  ],
  "$defs": {
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "../../world/1/common.schema.json#/$defs/slug"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        "nest_id": {
          "oneOf": [
            {
              "$ref": "../../world/1/common.schema.json#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_enu_m": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "yaw_rad": {
          "type": "number",
          "unit": "rad"
        },
        "initial_soc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sensors": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,24}$"
                  },
                  "type": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "limits_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "lights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nav": {
              "type": "boolean"
            },
            "strobe": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "model_id"
      ],
      "description": "vehicle instance configuration (AWR-17 §17.6.3 POST body; AWR-20 §7.7)"
    }
  }
}
