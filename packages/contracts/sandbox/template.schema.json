{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/sandbox/1/template.schema.json",
  "title": "awr.sandbox.template.v1 (scenario template)",
  "description": "scenarios/sandbox/<world>/<template>.json (AWR-04 §10.4; ADR-112), generated by tools/sandbox/gen_templates.py (M16): T1-T6 per world; the configuration part has the snapshot shape.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.sandbox.template.v1"
    },
    "template_id": {
      "type": "string",
      "pattern": "^t[1-9][0-9]*_[a-z0-9_]+$"
    },
    "world_id": {
      "$ref": "../../world/1/common.schema.json#/$defs/id"
    },
    "name_zh": {
      "type": "string"
    },
    "summary_zh": {
      "type": "string"
    },
    "first_feedback_zh": {
      "type": "string"
    },
    "recommended": {
      "type": "boolean"
    },
    "calendar_default": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_local": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      }
    },
    "acoustic_bg": {
      "enum": [
        "rural",
        "suburban",
        "urban"
      ]
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "type": "object"
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "../../vehicle/1/clone.schema.json"
      },
      "maxItems": 8
    },
    "nests": {
      "type": "array",
      "items": {
        "$ref": "../../tasking/1/nest.schema.json"
      },
      "maxItems": 4
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "../../world/1/common.schema.json#/$defs/slug"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          },
          "nest_id": {
            "oneOf": [
              {
                "$ref": "../../world/1/common.schema.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "home_enu_m": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "yaw_rad": {
            "type": "number",
            "unit": "rad"
          },
          "initial_soc": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sensors": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,24}$"
                    },
                    "type": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "limits_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "lights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nav": {
                "type": "boolean"
              },
              "strobe": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "model_id"
        ],
        "description": "vehicle instance configuration (AWR-17 §17.6.3 POST body; AWR-20 §7.7)"
      },
      "maxItems": 12
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "../../target/1/target.schema.json#/$defs/create_request"
      },
      "maxItems": 30
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "../../tasking/1/task.schema.json#/$defs/request"
      },
      "maxItems": 6
    },
    "camera": {
      "type": "object",
      "description": "initial view (M15)"
    },
    "anchors_ref": {
      "type": "string",
      "description": "scenarios/sandbox/anchors/<world>.json used to generate the template"
    }
  },
  "required": [
    "schema",
    "template_id",
    "world_id",
    "name_zh",
    "nests",
    "vehicles",
    "targets",
    "tasks"
  ]
}
