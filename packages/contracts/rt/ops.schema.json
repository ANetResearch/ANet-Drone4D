{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/rt/1/ops.schema.json",
  "title": "awr.rt.v1 control-plane JSON messages",
  "description": "UTF-8 JSON text frames, each with an op (AWR-17 §6.3). Envelope fields keep the frozen r27 camelCase names; business payloads (args, data, effect, detail, event data) are snake_case. Readers ignore unknown ops, fields and capabilities within the same major version. The top level uses anyOf because unadvertise has the same shape in both directions.",
  "anyOf": [
    {
      "$ref": "#/$defs/serverToClient"
    },
    {
      "$ref": "#/$defs/clientToServer"
    }
  ],
  "$defs": {
    "serverInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "serverInfo"
        },
        "name": {
          "const": "awr-gateway"
        },
        "protocol": {
          "const": "awr.rt.v1"
        },
        "sessionId": {
          "type": "string"
        },
        "connId": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "time",
              "credit",
              "rpc",
              "events",
              "clientPublish",
              "procHealth",
              "playbackControl",
              "m4"
            ]
          }
        },
        "window": {
          "type": "integer",
          "minimum": 3,
          "maximum": 8
        },
        "tickHz": {
          "const": 60
        },
        "rateClasses": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "frame": {
              "const": "world"
            },
            "contentVersion": {
              "type": "string"
            },
            "coordinateSha256": {
              "type": "string"
            },
            "anchorKind": {
              "type": "string"
            },
            "georeferenced": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "frame"
          ]
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "segment": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "segment"
          ]
        },
        "mode": {
          "enum": [
            "live",
            "replay"
          ]
        },
        "dataStart_ns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dataEnd_ns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "lockstep",
                "slaved_realtime",
                "live"
              ]
            },
            "pausable": {
              "type": "boolean"
            },
            "max_speed": {
              "type": "number"
            },
            "steppable": {
              "type": "boolean"
            }
          }
        },
        "role": {
          "enum": [
            "viewer",
            "operator",
            "admin"
          ]
        },
        "principal": {
          "type": "string"
        },
        "seat": {
          "enum": [
            "held",
            "none",
            "other"
          ]
        },
        "contracts": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "layouts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSubs": {
              "type": "integer"
            },
            "maxHighRateFull": {
              "type": "integer"
            },
            "ctrlQueue": {
              "type": "integer"
            },
            "maxTextBytes": {
              "type": "integer"
            },
            "maxBinaryBytes": {
              "type": "integer"
            }
          }
        },
        "serverUnix_ns": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "name",
        "protocol",
        "sessionId",
        "connId",
        "capabilities",
        "window",
        "tickHz",
        "world",
        "run",
        "mode",
        "contracts",
        "layouts"
      ]
    },
    "advertise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "advertise"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "topic": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "state",
                  "event",
                  "blob",
                  "roster"
                ]
              },
              "encoding": {
                "enum": [
                  "raw",
                  "msgpack",
                  "json",
                  "blob"
                ]
              },
              "schemaName": {
                "type": "string"
              },
              "layout": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "schemaRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nativeHz": {
                "type": "number"
              },
              "defaultRate": {
                "type": "integer"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "selfContained": {
                "type": "boolean"
              },
              "entity": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "topic",
              "kind",
              "encoding",
              "schemaName"
            ]
          }
        }
      },
      "required": [
        "op",
        "channels"
      ]
    },
    "unadvertise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unadvertise"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "op",
        "ids"
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "hello"
        },
        "client": {
          "type": "string"
        },
        "contracts": {
          "type": "string"
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "lastEventSeq": {
              "type": "integer"
            }
          },
          "required": [
            "sessionId",
            "lastEventSeq"
          ]
        },
        "maxKbps": {
          "type": "number"
        },
        "role": {
          "enum": [
            "viewer",
            "operator",
            "admin"
          ]
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "S"
          ]
        },
        "deviceClass": {
          "enum": [
            "software",
            "iGPU",
            "dGPU"
          ]
        }
      },
      "required": [
        "op",
        "client",
        "contracts"
      ]
    },
    "subscribe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "subscribe"
        },
        "subs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer"
              },
              "topic": {
                "type": "string"
              },
              "rate": {
                "type": "number"
              },
              "mode": {
                "enum": [
                  "latest",
                  "all",
                  "m4"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "filter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "levelMin": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  }
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "topic",
              "rate",
              "mode"
            ]
          }
        }
      },
      "required": [
        "op",
        "subs"
      ]
    },
    "subscribed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "subscribed"
        },
        "id": {
          "type": "integer"
        },
        "topic": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "rate": {
          "type": "number"
        },
        "mode": {
          "enum": [
            "latest",
            "all",
            "m4"
          ]
        },
        "added": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "id",
        "topic",
        "channels",
        "rate",
        "mode"
      ]
    },
    "unsubscribe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unsubscribe"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "op",
        "ids"
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ack"
        },
        "frame": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "decodeMs": {
          "type": "number"
        },
        "lagMs": {
          "type": "number"
        }
      },
      "required": [
        "op",
        "frame"
      ]
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ping"
        },
        "t": {
          "type": "number"
        },
        "srttMs": {
          "type": "number"
        }
      },
      "required": [
        "op",
        "t"
      ]
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "pong"
        },
        "t": {
          "type": "number"
        },
        "server_ns": {
          "type": "integer"
        },
        "sim_ns": {
          "type": "integer"
        },
        "epoch": {
          "type": "integer"
        },
        "unix_ns": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "t",
        "server_ns",
        "sim_ns",
        "epoch"
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "call"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "service": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "op",
        "id",
        "service"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "result"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "running",
            "succeeded",
            "failed",
            "canceled",
            "timeout"
          ]
        },
        "code": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "detail": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "remedy": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        },
        "dup_of": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry_after_ms": {
          "type": "integer"
        },
        "effect": {
          "$ref": "../../agent/1/effect.schema.json"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "op",
        "id",
        "status",
        "code"
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "progress"
        },
        "id": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "phase": {
              "enum": [
                "admitted",
                "planning",
                "executing",
                "paused"
              ]
            }
          }
        }
      },
      "required": [
        "op",
        "id",
        "data"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "cancel"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "event"
        },
        "seq": {
          "type": "integer"
        },
        "t_sim_ns": {
          "type": "integer"
        },
        "t_wall_ns": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "producer": {
          "type": "string"
        },
        "uav": {
          "type": [
            "string",
            "null"
          ]
        },
        "cid": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "op",
        "seq",
        "t_sim_ns",
        "type",
        "level",
        "data"
      ]
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "events"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer"
              },
              "t_sim_ns": {
                "type": "integer"
              },
              "t_wall_ns": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "producer": {
                "type": "string"
              },
              "uav": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "data": {
                "type": "object"
              }
            },
            "required": [
              "seq",
              "t_sim_ns",
              "type",
              "level",
              "data"
            ]
          }
        }
      },
      "required": [
        "op",
        "items"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "status"
        },
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        }
      },
      "required": [
        "op",
        "id",
        "level",
        "message"
      ]
    },
    "removeStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "removeStatus"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "op",
        "ids"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "error"
        },
        "code": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string"
            },
            "id": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "required": [
            "op"
          ]
        }
      },
      "required": [
        "op",
        "code",
        "name",
        "message"
      ]
    },
    "clientAdvertise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "advertise"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "topic": {
                "type": "string"
              },
              "encoding": {
                "const": "raw"
              },
              "schemaName": {
                "const": "awr.VelSetpoint16.v1"
              }
            },
            "required": [
              "id",
              "topic",
              "encoding",
              "schemaName"
            ]
          }
        }
      },
      "required": [
        "op",
        "channels"
      ],
      "description": "client publish advertise (C->S)"
    },
    "clientUnadvertise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unadvertise"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "op",
        "ids"
      ],
      "description": "client publish unadvertise (C->S)"
    },
    "clientStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "clientStats"
        },
        "fps": {
          "type": "number"
        },
        "frameMs": {
          "type": "number"
        },
        "frameP95Ms": {
          "type": "number"
        },
        "decodeMs": {
          "type": "number"
        },
        "heapMB": {
          "type": "number"
        },
        "droppedFrames": {
          "type": "integer"
        },
        "pointBudget": {
          "type": "integer"
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "S"
          ]
        },
        "deviceClass": {
          "enum": [
            "software",
            "iGPU",
            "dGPU"
          ]
        },
        "latencyP95Ms": {
          "type": "number"
        },
        "dGlobalMs": {
          "type": "number"
        }
      },
      "required": [
        "op"
      ]
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "playback"
        },
        "cmd": {
          "enum": [
            "open",
            "close",
            "play",
            "pause",
            "seek",
            "speed"
          ]
        },
        "run": {
          "$ref": "../../world/1/common.schema.json#/$defs/runId"
        },
        "segment": {
          "type": "integer"
        },
        "seek_ns": {
          "type": "integer"
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "cmd",
        "request_id"
      ]
    },
    "playbackState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "playbackState"
        },
        "status": {
          "enum": [
            "idle",
            "opening",
            "playing",
            "paused",
            "buffering",
            "ended",
            "error"
          ]
        },
        "current_ns": {
          "type": "integer"
        },
        "speed": {
          "type": "number"
        },
        "did_seek": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer"
        },
        "run": {
          "type": "string"
        },
        "segment": {
          "type": "integer"
        },
        "dataStart_ns": {
          "type": "integer"
        },
        "dataEnd_ns": {
          "type": "integer"
        },
        "code": {
          "type": "integer"
        },
        "speed_max": {
          "type": "number"
        },
        "loaded_until_ns": {
          "type": "integer"
        },
        "decimation_s": {
          "type": "number"
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "epoch": {
                "type": "integer"
              },
              "t_from_ns": {
                "type": "integer"
              },
