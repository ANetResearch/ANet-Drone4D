{
  "schema": "awr.units.v1",
  "doc": "Unit suffix dictionary used by UNIT-01 (tools/lint/check-units.mjs). Fields without a generic suffix use industry names and are registered in exceptions with their unit (AWR-03 §5.4). _ms means milliseconds only.",
  "suffixes": {
    "_m": {
      "unit": "m",
      "quantity": "length, position"
    },
    "_mps": {
      "unit": "m/s",
      "quantity": "speed"
    },
    "_mps2": {
      "unit": "m/s^2",
      "quantity": "acceleration"
    },
    "_rad": {
      "unit": "rad",
      "quantity": "angle"
    },
    "_rad_s": {
      "unit": "rad/s",
      "quantity": "angular rate"
    },
    "_deg": {
      "unit": "deg",
      "quantity": "angle (meteorology and UI only)"
    },
    "_deg_s": {
      "unit": "deg/s",
      "quantity": "angular rate (UI and gimbal)"
    },
    "_ns": {
      "unit": "ns",
      "quantity": "time point, int64"
    },
    "_ms": {
      "unit": "ms",
      "quantity": "duration in MILLISECONDS only"
    },
    "_s": {
      "unit": "s",
      "quantity": "duration"
    },
    "_us": {
      "unit": "us",
      "quantity": "duration in microseconds"
    },
    "_pct": {
      "unit": "%",
      "quantity": "percentage 0-100, u8 255 = unknown"
    },
    "_mmh": {
      "unit": "mm/h",
      "quantity": "precipitation rate (snow as water equivalent)"
    },
    "_pa": {
      "unit": "Pa",
      "quantity": "pressure"
    },
    "_c": {
      "unit": "degC",
      "quantity": "temperature"
    },
    "_kgm3": {
      "unit": "kg/m^3",
      "quantity": "density"
    },
    "_w": {
      "unit": "W",
      "quantity": "power"
    },
    "_wh": {
      "unit": "Wh",
      "quantity": "energy"
    },
    "_hz": {
      "unit": "Hz",
      "quantity": "frequency"
    },
    "_per_m": {
      "unit": "1/m",
      "quantity": "extinction coefficient"
    },
    "_v": {
      "unit": "V",
      "quantity": "voltage"
    },
    "_a": {
      "unit": "A",
      "quantity": "current"
    },
    "_ah": {
      "unit": "Ah",
      "quantity": "battery capacity"
    },
    "_kbps": {
      "unit": "kbit/s",
      "quantity": "bandwidth"
    },
    "_mb": {
      "unit": "MiB",
      "quantity": "size"
    },
    "_core": {
      "unit": "core",
      "quantity": "CPU cores (core-seconds per second)"
    },
    "_ms_per_s": {
      "unit": "ms/s",
      "quantity": "CPU time per simulated second"
    },
    "_dps": {
      "unit": "deg/s",
      "quantity": "yaw rate statistics"
    },
    "_px": {
      "unit": "px",
      "quantity": "pixels"
    },
    "_kg": {
      "unit": "kg",
      "quantity": "mass"
    },
    "_kgm2": {
      "unit": "kg*m^2",
      "quantity": "inertia"
    },
    "_m2": {
      "unit": "m^2",
      "quantity": "area"
    },
    "_m2kg": {
      "unit": "m^2/kg",
      "quantity": "area per mass"
    },
    "_n": {
      "unit": "N",
      "quantity": "force"
    },
    "_n_per_mps": {
      "unit": "N/(m/s)",
      "quantity": "linear drag coefficient"
    },
    "_k": {
      "unit": "K",
      "quantity": "temperature difference (netd)"
    },
    "_mm": {
      "unit": "mm",
      "quantity": "small length"
    },
    "_km": {
      "unit": "km",
      "quantity": "length (display)"
    },
    "_per_min": {
      "unit": "1/min",
      "quantity": "rate"
    },
    "_pct_s": {
      "unit": "%/s",
      "quantity": "rate of percentage"
    },
    "_mb_per_min": {
      "unit": "MiB/min",
      "quantity": "write rate"
    },
    "_mb_per_s": {
      "unit": "MiB/s",
      "quantity": "throughput"
    },
    "_cms": {
      "unit": "cm/s",
      "quantity": "Lite32 vel_cms only (binary layout)"
    },
    "_milli": {
      "unit": "x1/1000",
      "quantity": "fixed point x1000 (StateRing rate_milli, rtf_milli)"
    }
  },
  "denied_suffixes": {
    "_m_s": "write _mps",
    "_msec": "write _ms",
    "_sec": "write _s",
    "_secs": "write _s",
    "_kmh": "write _mps",
    "_kts": "write _mps",
    "_ft": "write _m",
    "_feet": "write _m",
    "_meters": "write _m",
    "_degrees": "write _deg",
    "_mph": "write _mps"
  },
  "denied_names": {
    "speed_ms": "speed_mps",
    "gust_amp_ms": "gust_amp_mps",
    "vmax_ms": "vmax_mps",
    "w_mean_ms": "w_mean_mps",
    "turb_sigma_u_ref_ms": "turb_sigma_u_ref_mps",
    "wind_rating_ms": "wind_rating_mps",
    "speed_ref_ms": "speed_ref_mps",
    "ref_speed_ms": "ref_speed_mps"
  },
  "unit_like_tokens": [
    "m",
    "mps",
    "ms",
    "s",
    "us",
    "ns",
    "deg",
    "rad",
    "hz",
    "pct",
    "kg",
    "km",
    "cm",
    "mm",
    "kmh",
    "kts",
    "ft",
    "min",
    "h",
    "sec",
    "secs",
    "msec",
    "mph",
    "w",
    "wh",
    "v",
    "a",
    "pa",
    "c",
    "px",
    "mb",
    "kb",
    "kbps",
    "n"
  ],
  "exceptions": [
    {
      "field": "noise_density",
      "unit": "rad/s/sqrt(Hz) (gyro), m/s^2/sqrt(Hz) (accel)",
      "where": "vehicle/imu.schema.json"
    },
    {
      "field": "random_walk",
      "unit": "rad/s^2/sqrt(Hz) (gyro), m/s^3/sqrt(Hz) (accel)",
      "where": "vehicle/imu.schema.json"
    },
    {
      "field": "turn_on_sigma",
      "unit": "rad/s (gyro), m/s^2 (accel)",
      "where": "vehicle/imu.schema.json"
    },
    {
      "field": "factor_sigma",
      "unit": "1",
      "where": "vehicle/imu.schema.json baro"
    },
    {
      "field": "c_rd",
      "unit": "N*s^2/(m*rad)",
      "where": "vehicle/vehicle_profile.schema.json prop"
    },
    {
      "field": "k_f",
      "unit": "N*s^2/rad^2",
      "where": "vehicle/vehicle_profile.schema.json motor"
    },
    {
      "field": "km_m",
      "unit": "m",
      "where": "vehicle/vehicle_profile.schema.json motor (reaction torque coefficient)"
    },
    {
      "field": "sih_kdv_equiv",
      "unit": "N/(m/s)",
      "where": "vehicle/vehicle_profile.schema.json aero"
    },
    {
      "field": "vmax_per_ref",
      "unit": "1",
      "where": "env/wind_manifest.schema.json vis"
    },
    {
      "field": "acc_unit",
      "unit": "string g",
      "where": "vehicle/lidar_livox.schema.json imu"
    },
    {
      "field": "gyro_unit",
      "unit": "string",
      "where": "vehicle/lidar_livox.schema.json imu"
    }
  ]
}
