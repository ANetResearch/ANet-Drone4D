{
  "schema": "awr.topics.v1",
  "doc": "Topic table (AWR-17 §6.6). native_hz 0 = change driven. default_rate by device tier S, B, A. rate classes [1,2,5,10,15,20,30,60]; tick 60 Hz. Deprecated topics: env/weather, env/wind/field, log (AWR-03 appendix B.1).",
  "rate_classes": [
    1,
    2,
    5,
    10,
    15,
    20,
    30,
    60
  ],
  "tick_hz": 60,
  "chunk_pattern": "^[a-z0-9][a-z0-9_-]*$",
  "default_subscriptions": [
    "fleet/roster@10",
    "swarm/uav/state@10|20",
    "uav/{focus}/state@30",
    "uav/{selected}/state@60",
    "uav/{selected}/state_ext@2",
    "uav/{selected}/safety@5",
    "uav/{selected}/env@10",
    "env/state@10",
    "event@all",
    "perf/server@1",
    "sys/procs@1"
  ],
  "deprecated": [
    {
      "pattern": "env/weather",
      "replaced_by": "env/state"
    },
    {
      "pattern": "env/wind/field",
      "replaced_by": "AWRV assets"
    },
    {
      "pattern": "log",
      "replaced_by": "event level 0"
    }
  ],
  "topics": [
    {
      "pattern": "fleet/roster",
      "kind": "roster",
      "encoding": "msgpack",
      "schemaName": "awr.fleet.roster.v1",
      "native_hz": 0,
      "default_rate": {
        "S": 10,
        "B": 10,
        "A": 10
      },
      "mode": "latest",
      "priority": 0,
      "self_contained": true,
      "owner": "M08",
      "d1": "core",
      "doc": "change driven"
    },
    {
      "pattern": "swarm/uav/state",
      "kind": "state",
      "encoding": "raw",
      "schemaName": "awr.SwarmLite32.v1",
      "native_hz": 125,
      "default_rate": {
        "S": 10,
        "B": 20,
        "A": 20
      },
      "mode": "latest",
      "priority": 1,
      "self_contained": false,
      "owner": "M08",
      "d1": "core",
      "aliases": [
