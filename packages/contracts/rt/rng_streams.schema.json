{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/rt/1/rng_streams.schema.json",
  "title": "rng_streams.json meta-schema",
  "description": "AWR-17 §10.8; ADR-049.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.rng_streams.v1"
    },
    "doc": {
      "type": "string"
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 63
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "purpose": {
            "type": "string"
          },
          "d1": {
            "enum": [
              "core",
              "ext",
              "stub",
              "no"
            ]
          }
        },
        "required": [
          "stream_id",
          "name",
          "owner",
          "purpose",
          "d1"
        ]
      }
    },
    "reserved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema",
    "streams"
  ]
}
