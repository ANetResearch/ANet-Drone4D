          "speed_mps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 12,
            "unit": "m/s",
            "description": "default: cruise speed of the active limits profile; above the profile limit it is clamped with warnings [SPEED_CLAMPED]"
          },
          "cw": {
            "type": "boolean",
            "default": true
          },
          "turns": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "yaw_behavior": {
            "enum": [
              "center",
              "tangent",
              "fixed"
            ],
            "default": "center"
          }
        },
        "required": [
          "center",
          "radius_m"
        ]
      },
      "admission": {
        "UNKNOWN": "-",
        "DISARMED": "-",
