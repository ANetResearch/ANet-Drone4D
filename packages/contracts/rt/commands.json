{
  "schema": "awr.commands.v1",
  "doc": "Service names, argument schemas (unit suffixes, AWR-03 §5.4), admission matrix and completion criteria (AWR-17 §7.1; AWR-12 §5.1-§5.4). The admission matrix is generated from state_model.admission_matrix() and equals AWR-12 §5.2 (BIZ-AC-002).",
  "admission_columns": [
    {
      "id": "UNKNOWN",
      "flight_state": "UNKNOWN"
    },
    {
      "id": "DISARMED",
      "flight_state": "DISARMED"
    },
    {
      "id": "PREFLIGHT",
      "flight_state": "PREFLIGHT"
    },
    {
      "id": "READY",
      "flight_state": "READY"
    },
    {
      "id": "TAKING_OFF",
      "flight_state": "TAKING_OFF"
    },
    {
      "id": "FLYING",
      "flight_state": "FLYING"
    },
    {
      "id": "CORRECTING",
      "flight_state": "CORRECTING"
    },
    {
      "id": "HOLD",
      "flight_state": "HOLD"
    },
    {
      "id": "RTL_op",
      "flight_state": "RTL",
      "failsafe": false
    },
    {
      "id": "RTL_auto",
      "flight_state": "RTL",
      "failsafe": true
    },
    {
      "id": "LANDING_op",
      "flight_state": "LANDING",
      "failsafe": false
    },
    {
      "id": "LANDING_auto",
      "flight_state": "LANDING",
      "failsafe": true
    },
    {
      "id": "ELAND",
      "flight_state": "ELAND"
    },
    {
      "id": "FAILSAFE",
      "flight_state": "FAILSAFE"
    },
    {
      "id": "LANDED",
      "flight_state": "LANDED"
    },
    {
      "id": "CRASHED",
      "flight_state": "CRASHED"
    }
  ],
  "admission_symbols": {
    "Y": {
      "code": 0,
      "meaning": "accept"
    },
    "=": {
      "code": 106,
      "meaning": "semantic duplicate, reply carries dup_of"
    },
    "S": {
      "code": 101,
      "meaning": "safety action active (114 LOCKED while locked)"
    },
    "-": {
      "code": 105,
      "meaning": "state"
    }
  },
  "admission_conditions": {
    "sub_ready_to_arm": {
      "doc": "only when the sub-mode is READY_TO_ARM",
      "else": "-"
    },
    "agl_ge_2m": {
      "doc": "requires AGL >= 2 m, landing continues otherwise",
      "else": "-"
    },
    "pause_active_nav": {
      "doc": "sub-mode in GOTO, PATH, ORBIT, SWARM with an active Track or navigation call",
      "else": "-"
    },
    "track_suspended": {
      "doc": "the vehicle Track is SUSPENDED",
      "else": "-"
    },
    "cause_cleared": {
      "doc": "the cause of HOLD or automatic RTL has been cleared; energy RTL never (101, detail BATTERY)",
      "else": "S"
    },
    "escalation_levels_failsafe": {
      "doc": "escalation.levels contains FAILSAFE (default absent)",
      "else": "-"
    }
  },
  "services": [
    {
      "name": "uav/{id}/cmd/takeoff",
      "op": "takeoff",
      "category": "nav_setup",
      "lease": true,
      "agent": "own_lease",
      "d1": "core",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alt_m": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 120,
            "default": 2.5,
            "unit": "m",
            "description": "AGL"
          },
          "auto_arm": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "admission": {
        "UNKNOWN": "-",
        "DISARMED": "Y",
        "PREFLIGHT": "-",
        "READY": "Y",
        "TAKING_OFF": "=",
        "FLYING": "-",
        "CORRECTING": "-",
        "HOLD": "-",
        "RTL_op": "-",
        "RTL_auto": "-",
        "LANDING_op": "-",
        "LANDING_auto": "-",
        "ELAND": "-",
        "FAILSAFE": "-",
        "LANDED": "Y",
        "CRASHED": "-"
      },
      "admission_cond": {
        "DISARMED": "sub_ready_to_arm"
      },
      "done": {
        "running_expect": "TAKING_OFF/*",
        "succeeded": "FLYING and |z - z_t| < max(0.3, 0.05*alt) and |vz| < 0.3 for 1 s",
        "metrics": [
          "alt_err_m",
          "t_exec_s"
        ],
        "deadline_expr": "alt_m/1.5*1.5 + 10 + 2"
      },
      "batchable": true
    },
    {
      "name": "uav/{id}/cmd/land",
      "op": "land",
      "category": "safety",
      "lease": false,
      "agent": "own_lease",
      "d1": "core",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "oneOf": [
              {
                "enum": [
                  "here",
                  "home"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "pos"
                ]
              }
            ],
            "default": "here"
          }
        }
      },
      "admission": {
        "UNKNOWN": "-",
        "DISARMED": "-",
        "PREFLIGHT": "-",
        "READY": "-",
        "TAKING_OFF": "Y",
        "FLYING": "Y",
        "CORRECTING": "Y",
        "HOLD": "Y",
        "RTL_op": "Y",
        "RTL_auto": "Y",
        "LANDING_op": "=",
        "LANDING_auto": "=",
        "ELAND": "S",
        "FAILSAFE": "S",
        "LANDED": "=",
        "CRASHED": "-"
      },
      "done": {
        "running_expect": "LANDING/*",
        "succeeded": "passed LANDED and reached DISARMED",
        "metrics": [
          "pos_err_m"
        ],
        "deadline_expr": "alt_m/0.7*1.5 + 10"
      },
      "batchable": true
    },
    {
      "name": "uav/{id}/cmd/goto",
      "op": "goto",
      "category": "nav",
      "lease": true,
      "agent": "yes",
      "d1": "core",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "unit": "m",
            "description": "world ENU"
          },
          "yaw_rad": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793,
            "default": null,
            "unit": "rad"
          },
          "speed_mps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 12,
            "unit": "m/s",
            "description": "default: cruise speed of the active limits profile; above the profile limit it is clamped with warnings [SPEED_CLAMPED]"
          },
          "tol_m": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 10,
            "default": 0.5,
            "unit": "m"
          },
          "route": {
            "enum": [
              "auto",
              "direct",
              "safe_transit"
            ],
            "default": "auto"
          }
        },
        "required": [
          "pos"
        ]
      },
      "admission": {
        "UNKNOWN": "-",
        "DISARMED": "-",
        "PREFLIGHT": "-",
        "READY": "-",
        "TAKING_OFF": "-",
        "FLYING": "Y",
        "CORRECTING": "S",
        "HOLD": "S",
        "RTL_op": "Y",
        "RTL_auto": "S",
        "LANDING_op": "Y",
        "LANDING_auto": "S",
        "ELAND": "S",
        "FAILSAFE": "S",
        "LANDED": "-",
        "CRASHED": "-"
      },
      "done": {
        "running_expect": "FLYING/GOTO (direct) or FLYING/PATH (safe_transit)",
        "succeeded": "|p - p_t| < tol and |v| < 0.5 for 1 s",
        "metrics": [
          "dist_err_m",
          "t_exec_s"
        ],
        "deadline_expr": "1.5*ETA + 10, ETA = d/v + v/a"
      }
    },
    {
      "name": "uav/{id}/cmd/follow_path",
      "op": "follow_path",
      "category": "nav",
      "lease": true,
      "agent": "yes",
      "d1": "core",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "description": "total length <= 20 km"
          },
          "speed_mps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 12,
            "unit": "m/s",
            "description": "default: cruise speed of the active limits profile; above the profile limit it is clamped with warnings [SPEED_CLAMPED]"
          },
          "mode": {
            "enum": [
              "auto",
              "mission",
              "offboard"
            ],
            "default": "auto"
          },
          "bspline": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "order": {
                "const": 3
              },
              "ts_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ctrl_pts": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "t0_ns": {
                "type": "integer"
              },
              "traj_id": {
                "type": "string"
              }
            },
            "required": [
              "order",
              "ts_s",
              "ctrl_pts"
            ]
          }
        },
        "required": [
          "waypoints"
        ]
      },
      "admission": {
        "UNKNOWN": "-",
        "DISARMED": "-",
        "PREFLIGHT": "-",
        "READY": "-",
        "TAKING_OFF": "-",
        "FLYING": "Y",
        "CORRECTING": "S",
        "HOLD": "S",
        "RTL_op": "Y",
        "RTL_auto": "S",
        "LANDING_op": "Y",
        "LANDING_auto": "S",
        "ELAND": "S",
        "FAILSAFE": "S",
        "LANDED": "-",
        "CRASHED": "-"
      },
      "done": {
        "running_expect": "FLYING/PATH",
        "succeeded": "last point meets the arrival criterion",
        "metrics": [
          "path_len_m",
          "max_dev_m"
        ],
        "deadline_expr": "1.5*sum(ETA) + 10"
      },
      "notes": [
        "bspline is D1-ext (ADR-039)"
      ]
    },
    {
      "name": "uav/{id}/cmd/orbit",
      "op": "orbit",
      "category": "nav",
      "lease": true,
      "agent": "yes",
      "d1": "core",
      "args_schema": {
        "type": "object",
