{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/target/1/assets.catalog.schema.json",
  "title": "Optional target asset catalog v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "awr.target-assets.v1"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "class": {
            "enum": [
              "person",
              "vehicle",
              "dog",
              "uav",
              "machine",
              "object"
            ]
          },
          "name_zh": {
            "type": "string",
            "minLength": 1
          },
          "name_en": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "source_geometry_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_texture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "geometry_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "texture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vertices": {
            "type": "integer",
            "minimum": 1
          },
          "triangles": {
            "type": "integer",
            "minimum": 1
          },
          "poses": {
            "type": "integer",
            "minimum": 0
          },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "p": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              },
              "n": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              },
              "uv": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              },
              "c": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              },
              "poses": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              },
              "indices": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "multipleOf": 4
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "offset",
                  "count"
                ]
              }
            },
            "required": [
              "p",
              "n",
              "uv",
              "c",
              "poses",
              "indices"
            ]
          },
          "dimensions_m": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "stride_m": {
            "type": "number",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "texture_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "wheels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "vertices": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "sha256",
              "bytes",
              "count",
              "vertices"
            ]
          }
        },
        "required": [
          "id",
          "class",
          "name_zh",
          "name_en",
          "license",
          "source",
          "source_geometry_sha256",
          "source_texture_sha256",
          "geometry_sha256",
          "texture_sha256",
          "vertices",
          "triangles",
          "poses",
          "layout",
          "dimensions_m",
          "stride_m",
          "bytes",
          "texture_bytes"
        ]
      }
    }
  },
  "required": [
    "format",
    "assets"
  ]
}
