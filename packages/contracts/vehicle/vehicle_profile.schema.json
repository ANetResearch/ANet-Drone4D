        },
        "sih_kdv_equiv": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "conf": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "conf",
            "src"
          ],
          "unit": "N/(m/s)"
        }
      },
      "required": [
        "model"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "model": {
                "const": "linear"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "k_dv_n_per_mps"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "model": {
                "const": "composite"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "cda_m2"
            ]
          }
        }
      ]
    },
