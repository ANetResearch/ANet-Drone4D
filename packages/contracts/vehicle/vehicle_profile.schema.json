{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/vehicle/1/vehicle_profile.schema.json",
  "title": "Vehicle profile params.yaml (awr.vehicle.v1)",
  "description": "AWR-16 §11.2: every identifiable parameter is {value, conf A-D, src}; conf E values live only in rejected[]. Loader runs VH-1..VH-7 and rejects on failure (353). Keys snake_case with unit suffix; px4_params keeps PX4 names.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.vehicle.v1"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "uav"
    },
    "status": {
      "enum": [
        "regression",
        "placeholder",
        "identified"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "quad_x",
            "hex_x"
          ]
        },
        "rotor_order": {
          "const": "px4"
        },
        "body": {
          "const": "frd"
        }
      },
      "required": [
        "type",
        "rotor_order",
        "body"
      ]
    },
    "mass_kg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conf": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "conf",
        "src"
      ],
      "unit": "kg"
    },
    "mtow_kg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conf": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "conf",
        "src"
      ],
      "unit": "kg"
    },
    "inertia_kgm2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "yy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "zz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "xx",
            "yy",
            "zz"
          ]
        },
        "conf": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "conf",
        "src"
      ],
      "unit": "kg*m^2"
