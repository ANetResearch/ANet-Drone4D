    "prop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "d_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "conf": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
