{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/bus/1/roster.schema.json",
  "title": "Roster reply (ctl/<producer>/roster)",
  "description": "AWR-17 §9.4; entries as awr.fleet.roster.v1.",
