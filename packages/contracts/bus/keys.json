      "consumers": [
        "api",
        "sandbox-pool"
      ],
      "qos": {
        "priority": "DATA_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "{stage_ms_per_s{}, n_active, kernel, cpu_pct}; D2 adds clock_profile, cpu_win_core, rtf_win, rate_set, cost_core_per_rate, n_uav, n_target, ray_rate_hz, rays_dropped, rss_anon_mb, clock_lock (M08 §15.3.7)",
