{
  "schema": "awr.bus.keys.v1",
  "doc": "Zenoh key space relative to the namespace awr/<world>/<run> (AWR-17 §9.3; ADR-051). Code must build keys through the generated awr.contracts.bus_keys module; key literals elsewhere are rejected by lint (AWR-17 §10.6 rule 11). Placeholders: {producer}, {name}, {cat}, {op}, {what}.",
  "namespace": "awr/{world}/{run}",
  "chunk_pattern": "^[a-z0-9][a-z0-9_-]*$",
  "event_categories": [
    "cmd",
    "safety",
    "mission",
    "sim",
    "env",
    "lease",
    "proc",
    "rec",
    "job",
    "world",
    "sensor",
    "agent",
    "health",
    "target",
    "perception",
    "nest",
    "task",
    "relay",
    "sandbox"
  ],
  "producers": [
    "sim-core",
    "replay",
    "api",
    "supervisor",
    "recorder",
    "replay-worker",
    "agent-runtime",
    "job-worker",
    "geo-worker",
    "sandbox-pool",
    "sandbox-api"
  ],
  "keys": [
    {
      "name": "PROC_ALIVE",
      "key": "proc/{name}/alive",
      "type": "liveliness",
      "producer": "every process",
      "consumers": [
        "all"
      ],
      "qos": null,
      "payload": null,
      "d1": "core"
    },
    {
      "name": "PROC_READY",
      "key": "proc/{name}/ready",
      "type": "liveliness",
      "producer": "every process",
      "consumers": [
        "all"
      ],
      "qos": null,
      "payload": null,
      "d1": "core"
    },
    {
      "name": "CTL_CMD",
      "key": "ctl/{producer}/cmd",
      "type": "queryable",
      "producer": "api, agent-runtime",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_HIGH",
        "congestion": "DROP",
        "express": true
      },
      "payload": "bus/command.schema.json#/$defs/command -> #/$defs/admission",
      "d1": "core"
    },
    {
      "name": "CTL_CLOCK",
      "key": "ctl/sim-core/clock",
      "type": "queryable",
      "producer": "api",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_HIGH",
        "congestion": "DROP",
        "express": true
      },
      "payload": "bus/command.schema.json#/$defs/clockOp -> #/$defs/clockReply",
      "d1": "core"
    },
    {
      "name": "CTL_LEASE",
      "key": "ctl/sim-core/lease",
      "type": "queryable",
      "producer": "api, agent-runtime",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_HIGH",
        "congestion": "DROP",
        "express": true
      },
      "payload": "bus/command.schema.json#/$defs/leaseOp -> #/$defs/leaseReply",
      "d1": "core"
    },
    {
      "name": "CTL_ROSTER",
      "key": "ctl/{producer}/roster",
      "type": "queryable",
      "producer": "api, recorder, agent-runtime",
      "consumers": [
        "sim-core",
        "replay"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/roster.schema.json",
      "d1": "core"
    },
    {
      "name": "CTL_ESTIMATE",
      "key": "ctl/sim-core/estimate",
      "type": "queryable",
      "producer": "agent-runtime, mission engine",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/command.schema.json#/$defs/estimateReq -> #/$defs/estimateReply",
      "d1": "core"
    },
    {
      "name": "CTL_QUERY",
      "key": "ctl/sim-core/query",
      "type": "queryable",
      "producer": "api, agent-runtime",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/command.schema.json#/$defs/queryReq -> msgpack SoA",
      "d1": "core"
    },
    {
      "name": "CTL_SETPOINT",
      "key": "ctl/sim-core/setpoint",
      "type": "pubsub",
      "producer": "api",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "REAL_TIME",
        "congestion": "DROP",
        "express": true
      },
      "payload": "raw awr.bus.Setpoint32.v1; frame 0 world, 1 body, 2 fw (D2)",
      "d1": "core"
    },
    {
      "name": "CTL_GCS",
      "key": "ctl/sim-core/gcs",
      "type": "pubsub",
      "producer": "api",
      "consumers": [
        "sim-core"
      ],
      "qos": {
        "priority": "INTERACTIVE_HIGH",
        "congestion": "DROP",
        "express": true
      },
      "payload": "bus/gcs.schema.json",
      "d1": "core",
      "doc": "5 Hz wall clock"
    },
    {
      "name": "CTL_INTEREST",
      "key": "ctl/sim-core/interest",
      "type": "pubsub",
      "producer": "api",
      "consumers": [
        "sim-core",
        "recorder"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/interest.schema.json (D2: topics perception, nav, radar, acoustic, lidar and streams{})",
      "d1": "core"
    },
    {
      "name": "EVT",
      "key": "evt/{producer}/{cat}",
      "type": "pubsub",
      "producer": "producers",
      "consumers": [
        "api",
        "recorder",
        "agent-runtime"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "msgpack array of bus/event.schema.json",
      "d1": "core",
      "doc": "cat in cmd, safety, mission, sim, env, lease, proc, rec, job, world, sensor, agent (health from V0.2); safety uses INTERACTIVE_HIGH"
    },
    {
      "name": "EVT_REPLAY",
      "key": "evt/{producer}/_replay",
      "type": "queryable",
      "producer": "producers",
      "consumers": [
        "api",
        "recorder"
      ],
      "qos": {
        "priority": "INTERACTIVE_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/replay.schema.json#/$defs/replayReq -> #/$defs/replayRep",
      "d1": "core"
    },
    {
      "name": "STATE_EXT",
      "key": "state/{producer}/ext",
      "type": "pubsub",
      "producer": "producers",
      "consumers": [
        "api",
        "recorder"
      ],
      "qos": {
        "priority": "DATA_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "2 Hz batch of awr.uav.state_ext.v1",
      "d1": "core"
    },
    {
      "name": "STATE_SAFETY",
      "key": "state/{producer}/safety",
      "type": "pubsub",
      "producer": "producers",
      "consumers": [
        "api",
        "recorder"
      ],
      "qos": {
        "priority": "DATA_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "10 Hz [[agent_no, row_bytes]] of awr.uav.safety.v1 for interest set and marks",
      "d1": "core"
    },
    {
      "name": "STATE_SENSOR",
      "key": "state/{producer}/sensor",
      "type": "pubsub",
      "producer": "producers",
      "consumers": [
        "api",
        "recorder"
      ],
      "qos": {
        "priority": "DATA_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/detail.schema.json (SensorPose48 rows)",
      "d1": "core"
    },
    {
      "name": "STATE_DETAIL",
      "key": "state/sim-core/detail",
      "type": "pubsub",
      "producer": "sim-core",
      "consumers": [
        "api",
        "recorder"
      ],
      "qos": {
        "priority": "DATA_LOW",
        "congestion": "DROP",
        "express": false
      },
      "payload": "bus/detail.schema.json (EnvSample32 rows)",
      "d1": "core"
    },
    {
      "name": "STATE_PERF",
      "key": "state/sim-core/perf",
      "type": "pubsub",
