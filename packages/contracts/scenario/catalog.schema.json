{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/scenario/1/catalog.schema.json",
  "title": "awr.scenario_catalog.v1 (scenarios/catalog.json)",
  "description": "AWR-16 §12.1; M16 §7.3.1. V-SC-13 checks references statically.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.scenario_catalog.v1"
    },
    "schema_version": {
      "$ref": "../../world/1/common.schema.json#/$defs/semver"
    },
    "worlds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default": {
            "$ref": "../../world/1/common.schema.json#/$defs/slug"
          },
          "demo": {
            "type": "array",
            "items": {
              "$ref": "../../world/1/common.schema.json#/$defs/slug"
            }
          },
          "gate": {
            "type": "boolean"
          }
        },
        "required": [
          "default",
          "demo"
        ]
      }
    },
    "ui_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(#[a-z0-9_-]+)?$"
        }
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "worlds"
  ]
}
