{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/classes/1/d3-semantic.schema.json",
  "title": "Semantic code table d3-semantic@N (camera semantic maps and LiDAR truth)",
  "description": "M25 §6.4.6; registered in AWR-16 §24.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "classes"
  ],
  "properties": {
    "schema": {
      "const": "awr.classes.d3_semantic.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^d3-semantic@[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "key",
          "source"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source": {
            "enum": [
              "anet-classes@1",
              "actor",
              "none"
            ]
          },
          "reflect_905": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Default reflectance at 905 nm"
          }
        }
      }
    }
  }
}
