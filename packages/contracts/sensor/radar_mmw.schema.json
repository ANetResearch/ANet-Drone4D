{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/sensor/1/radar_mmw.schema.json",
  "title": "awr.sensor.radar_mmw.v1 (77 GHz FMCW radar)",
  "description": "Model file vehicles/sensor_models/<id>.yaml or mount file vehicles/<dir>/sensors/<file>.yaml (AWR-20 §7.5): a model file carries model_id and model_version; a mount file carries sensor_id, spec_ref and mount plus whitelisted overrides; the effective spec is deep_merge(model, mount). SNR = 13.2 + 10 lg(sigma) - 40 lg(R / R_ref) - 2 gamma_rain R / 1000 (AWR-04 §6.2).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awr.sensor.radar_mmw.v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string"
    },
    "reference": {
      "type": "boolean"
    },
    "mass_kg": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "conf": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "conf",
            "src"
          ]
        }
      ]
    },
    "power_w": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "conf": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "conf",
            "src"
          ]
        }
      ]
    },
    "env_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temp_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "overridable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conf": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "src": {
      "type": "string"
    },
    "sensor_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,23}$"
    },
    "spec_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xyz_m": {
          "$ref": "../../world/1/common.schema.json#/$defs/vec3"
        },
        "rpy_deg": {
          "$ref": "../../world/1/common.schema.json#/$defs/vec3"
        },
        "q_xyzw": {
          "$ref": "../../world/1/common.schema.json#/$defs/quatXYZW"
        },
        "preset": {
          "type": "string"
        }
      },
      "required": [
        "xyz_m"
      ]
    },
    "on_gimbal_of": {
      "type": "string"
    },
    "gimbal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pitch_min_deg": {
          "type": "number",
          "unit": "deg"
        },
        "pitch_max_deg": {
          "type": "number",
          "unit": "deg"
        },
        "yaw_min_deg": {
          "type": "number",
          "unit": "deg"
        },
        "yaw_max_deg": {
          "type": "number",
          "unit": "deg"
        },
        "rate_max_deg_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "deg/s"
        },
        "integrated": {
          "type": "boolean"
        },
        "default_mode": {
          "type": "string"
        },
        "default_yaw_deg": {
          "type": "number",
          "unit": "deg"
        },
        "default_pitch_deg": {
          "type": "number",
          "unit": "deg"
        }
      }
    },
    "freq_ghz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "GHz"
    },
    "fov": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "az_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "deg"
        },
        "el_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "deg"
        }
      }
    },
    "r_ref_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "m"
    },
    "sigma_ref_m2": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "m^2"
    },
    "pd_ref": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pfa": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "snr_req_db": {
      "type": "number",
      "unit": "dB"
    },
    "range_res_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "m"
    },
    "az_res_deg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "deg"
    },
    "vel_res_mps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "m/s"
    },
    "az_acc_deg": {
      "type": "number",
      "minimum": 0,
      "unit": "deg"
    },
    "rate_hz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "Hz"
    },
    "r_max_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "unit": "m"
    },
    "rain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "k": {
          "type": "number"
        },
        "alpha": {
          "type": "number"
        }
      }
    },
    "clutter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sigma0_db": {
          "type": "number",
          "unit": "dB"
        },
        "k": {
          "type": "number"
        }
      }
    },
    "classify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snr_db": {
          "type": "number",
          "unit": "dB"
        },
        "dwell_s": {
          "type": "number",
          "minimum": 0,
          "unit": "s"
        }
      }
    }
  },
  "required": [
    "schema"
  ],
  "anyOf": [
    {
      "required": [
        "model_id",
        "model_version"
      ]
    },
    {
      "required": [
        "sensor_id",
        "spec_ref"
      ]
    }
  ]
}
