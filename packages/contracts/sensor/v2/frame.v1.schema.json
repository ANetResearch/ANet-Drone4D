{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/sensor-v2/1/frame.v1.schema.json",
  "title": "Camera frame record (drone4d.frame.v1)",
  "description": "AWR-05 §8.1, M25 §7.2.1 (contracts 1.3.0, d1 V0.3). Three partitions: agent_view (the source set that M26 projects into bench/obs.v1 CameraObs), ground_truth (evaluation store and truth files only, ADR-161) and internal (provenance). Units: times in ns, K in px with pixel centres at 0.5, distances in m, angles in deg. Thermal frames (kind = thermal, P0b, M25 §15.6; additive in contracts 1.3.x) carry agent_view.temp_ck instead of rgb and depth, ground_truth.objects[].dT_app_k, the thermal timing fields and internal.thermal; the camera-only requirements (rgb, invalid_mask, blur_subframes, rs_bands, rs_method) are enforced per kind in allOf. internal.appearance uses the run_spec values (mesh, 3dgs); appearance_source and appearance_version are added in contracts 1.3.x (additive, M25-FR-194, FR-201).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.frame.v1"
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+/[^/]+/[0-9]+$",
      "description": "<run_id>/<uav>/<sensor>/<seq>; internal identifier, never part of obs.v1"
    },
    "kind": {
      "enum": [
        "camera",
        "thermal"
      ],
      "description": "camera or thermal (P0b; the thermal record is the source set of bench/obs.v1 ThermalObs); LiDAR uses lidar_frame.v2"
    },
    "agent_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "t_mid_ns": {
          "type": "integer",
          "description": "Exposure midpoint of the middle row"
        },
        "exposure_ns": {
          "type": "integer",
          "minimum": 0
        },
        "readout_ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Rolling shutter readout window; 0 for a global shutter"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "K": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 9,
          "maxItems": 9,
          "description": "Row-major intrinsics of the delivered image"
        },
        "dist": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 5,
          "maxItems": 5,
          "description": "OpenCV k1 k2 p1 p2 k3 of the delivered image"
        },
        "pixel_convention": {
          "const": "colmap_center_0.5"
        },
        "mount_nominal": {
          "type": "object",
          "additionalProperties": false,
          "description": "Nominal mount, ZYX, FLU",
          "properties": {
            "xyz_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rpy_deg": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "xyz_m",
            "rpy_deg"
          ]
        },
        "gimbal_reading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "az_deg": {
              "type": "number"
            },
            "el_deg": {
              "type": "number"
            },
            "zoom_f_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "az_deg",
            "el_deg"
          ],
          "description": "Gimbal reading with encoder noise"
        },
        "rgb": {
          "type": "object",
          "additionalProperties": false,
          "description": "sha256 over the delivered bytes; the archive stores the same bytes",
          "properties": {
            "codec": {
              "enum": [
                "jpeg",
                "raw"
              ]
            },
            "quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "codec",
            "ref",
            "sha256"
          ]
        },
        "depth": {
          "type": "object",
          "additionalProperties": false,
          "description": "L2-depth only",
          "properties": {
            "dtype": {
              "const": "f32"
            },
            "unit": {
              "const": "m"
            },
            "type": {
              "const": "planar_z"
            },
            "range_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "dtype",
            "unit",
            "type",
            "range_m",
            "ref",
            "sha256"
          ]
        },
        "temp_ck": {
          "type": "object",
          "additionalProperties": false,
          "description": "Thermal only: apparent temperature, u16 little-endian, 0.01 K per LSB (temp_ck = floor(T_app * 100 + 0.5), saturated to [0, 65535]), zstd level 3 single frame. sha256 over the delivered bytes; ThermalObs.temp_ck and the raw.mcap archive carry the same bytes",
          "properties": {
            "dtype": {
              "const": "u16"
            },
            "unit": {
              "const": "0.01 K"
            },
            "codec": {
              "const": "radiometric_u16"
            },
            "compression": {
              "const": "zstd"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "dtype",
            "unit",
            "codec",
            "compression",
            "ref",
            "sha256"
          ]
        }
      },
      "required": [
        "sensor_id",
        "seq",
        "t_mid_ns",
        "exposure_ns",
        "readout_ns",
        "width",
        "height",
        "K",
        "dist",
        "pixel_convention",
        "mount_nominal",
        "gimbal_reading"
      ]
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "T_world_sensor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pos_enu_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "q_ws_xyzw": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "frame": {
              "const": "ENU<-RDF"
            }
          },
          "required": [
            "pos_enu_m",
            "q_ws_xyzw",
            "frame"
          ]
        },
        "gimbal_true": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "az_deg": {
              "type": "number"
            },
            "el_deg": {
              "type": "number"
            },
            "zoom_f_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "az_deg",
            "el_deg"
          ]
        },
        "instance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {
              "const": "u16"
            },
            "codec": {
              "const": "zstd"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            }
          },
          "required": [
            "dtype",
            "codec",
            "ref"
          ],
          "description": "0 static, actor idx + 1"
        },
        "instance_unocc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {
              "const": "u16"
            },
            "codec": {
              "const": "zstd"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            }
          },
          "required": [
            "dtype",
            "codec",
            "ref"
          ],
          "description": "Actors-only pass (unoccluded), same coding as instance"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {
              "const": "u8"
            },
            "codec": {
              "const": "zstd"
            },
            "code_table": {
              "const": "d3-semantic@1"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            }
          },
          "required": [
            "dtype",
            "codec",
            "code_table",
            "ref"
          ]
        },
        "invalid_mask": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {
              "const": "u8"
            },
            "codec": {
              "const": "zstd"
            },
            "bits": {
              "type": "array",
              "items": {
                "enum": [
                  "void_below_horizon",
                  "stretched",
                  "outside_coverage",
                  "hole_edge",
                  "water"
                ]
              },
              "description": "Bit names in order from bit 0 (M25 §6.6.2); bits 5-7 reserved"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            }
          },
          "required": [
            "dtype",
            "codec",
            "bits",
            "ref"
          ]
        },
        "gt_depth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {
              "const": "f32"
            },
            "unit": {
              "const": "m"
            },
            "codec": {
              "const": "bshuf4-zstd",
              "description": "Lossless archive form: the 4 byte planes of the f32le image, zstd compressed; absent = plain f32le"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Payload block: an attached binary section of the same MCAP message, or a relative path in a file export"
            }
          },
          "required": [
            "dtype",
            "unit",
            "ref"
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "description": "Visibility reduction over the delivered image (M25 §6.6.1); actors with px_unoccluded > 0",
            "properties": {
              "inst": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "actor": {
                "type": "string"
              },
              "class": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "description": "d3-semantic@1 code"
              },
              "px_visible": {
                "type": "integer",
                "minimum": 0
              },
              "px_unoccluded": {
                "type": "integer",
                "minimum": 1
              },
              "h_px_unocc": {
                "type": "integer",
                "minimum": 0
              },
              "h_px_visible": {
                "type": "integer",
                "minimum": 0
              },
              "visible_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox_xywh": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "bbox_unocc_xywh": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "occluder_sem_px": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]{1,3}$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Occluding foreground pixels by d3-semantic@1 code"
              },
              "flags": {
                "type": "array",
                "items": {
                  "enum": [
                    "truncated",
                    "no_ring"
                  ]
                }
              },
              "dT_app_k": {
                "type": "number",
                "description": "Thermal only: median noise-free apparent temperature of the visible pixels minus the median of the ring within Chebyshev distance 3 px that contains no actor pixel (K); absent with flag no_ring when the ring is empty"
              }
            },
            "required": [
              "inst",
              "actor",
              "class",
              "px_visible",
              "px_unoccluded",
              "h_px_unocc",
              "h_px_visible",
              "visible_ratio",
              "bbox_xywh",
              "bbox_unocc_xywh",
              "occluder_sem_px",
              "flags"
            ]
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Truth-layer sample times",
          "properties": {
            "t_truth_ns": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 1,
              "maxItems": 1
            },
            "blur_subframes": {
              "type": "integer",
              "minimum": 1
            },
            "rs_bands": {
              "type": "integer",
              "minimum": 1
            },
            "rs_method": {
              "enum": [
                "vertex",
                "bands"
              ],
              "description": "Rolling shutter method (ADR-179): vertex (default) or bands (reference)"
            },
            "rs_nodes": {
              "type": "integer",
              "minimum": 2,
              "description": "Rolling shutter (vertex): camera pose nodes across the readout window (M25 §15.4)"
            },
            "readout_window_ns": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Rolling shutter readout window [t_mid - T_ro/2, t_mid + T_ro/2] in ns"
            },
            "lag_subframes": {
              "type": "integer",
              "minimum": 1,
              "description": "Thermal only: detector subframes S of the bolometer lag model (M25 §15.6 step 5)"
            },
            "subframe_weights": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 1,
              "description": "Thermal only: subframe weights in time order (sum 1)"
            }
          },
          "required": [
            "t_truth_ns"
          ]
        }
      },
      "required": [
        "T_world_sensor",
        "gimbal_true",
        "instance",
        "instance_unocc",
        "semantic",
        "objects",
        "timing"
      ]
    },
    "internal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "world_content_version": {
          "type": "string"
        },
        "dynamic_source_id": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "renderer_version": {
          "type": "string"
        },
        "fx_version": {
          "type": "string"
        },
        "appearance": {
          "enum": [
            "mesh",
            "3dgs"
          ],
          "description": "Same values as bench/run_spec.v1 appearance"
        },
        "appearance_source": {
          "enum": [
            "mesh",
            "aerial",
            "mesh_distilled",
            "generative"
          ],
          "description": "M25-FR-194: mesh when appearance = mesh, otherwise the run_spec appearance_source; mesh_distilled and generative frames are never presented as real imagery"
        },
        "appearance_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "M25-FR-201: sha256 of the appearance layer visual/gaussian/provenance.json; null when appearance = mesh"
        },
        "noise_tier": {
          "type": "string"
        },
        "noise_table_version": {
          "type": "string"
        },
        "encoder": {
          "type": "string"
        },
        "gpu_model": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "run_seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Filled in by M27 when writing the evaluation store; kept from agents in ranked runs"
        },
        "derived": {
          "type": "boolean",
          "description": "true for offline re-rendering"
        },
        "thermal": {
          "type": "object",
          "additionalProperties": false,
          "description": "Thermal only (M25-FR-186, FR-187): versions and digests of the parameter table, the band-integrated Planck table, the noise profile and thermal_static.npz",
          "properties": {
            "renderer": {
              "type": "string"
            },
            "thermal_table": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "version",
                "sha256"
              ]
            },
            "planck_table": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "band_um": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "version",
                "sha256",
                "band_um"
              ]
            },
            "noise": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                },
                "netd_mk_300k": {
                  "type": "number",
                  "minimum": 0
                },
                "fpn_offset_k": {
                  "type": "number",
                  "minimum": 0
                },
                "fpn_gain_frac": {
                  "type": "number",
                  "minimum": 0
                },
                "optics_sigma_px": {
                  "type": "number",
                  "minimum": 0
                },
                "tau_bolometer_s": {
                  "type": "number",
                  "minimum": 0
                },
                "lag_subframes": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "version",
                "profile",
                "netd_mk_300k",
                "fpn_offset_k",
                "fpn_gain_frac",
                "optics_sigma_px",
                "tau_bolometer_s",
                "lag_subframes"
              ]
            },
            "thermal_static": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sun_az_el_deg": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "backend": {
                  "type": "string"
                }
              },
              "required": [
                "sha256",
                "sun_az_el_deg",
                "backend"
              ]
            }
          },
          "required": [
            "renderer",
            "thermal_table",
            "planck_table",
            "noise"
          ]
        }
      },
      "required": [
        "run_id",
        "session_id",
        "world_content_version",
        "dynamic_source_id",
        "backend",
        "renderer_version",
        "fx_version",
        "appearance",
        "noise_tier",
        "noise_table_version",
        "encoder",
        "gpu_model",
        "driver",
        "derived"
      ]
    }
  },
  "required": [
    "schema",
    "frame_id",
    "kind",
    "agent_view",
    "ground_truth",
    "internal"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "camera"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "agent_view": {
            "required": [
              "rgb"
            ],
            "not": {
              "required": [
                "temp_ck"
              ]
            }
          },
          "ground_truth": {
            "required": [
              "invalid_mask"
            ],
            "properties": {
              "timing": {
                "required": [
                  "blur_subframes",
                  "rs_bands",
                  "rs_method"
                ]
              }
            }
          },
          "internal": {
            "not": {
              "required": [
                "thermal"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "thermal"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "agent_view": {
            "required": [
              "temp_ck"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rgb"
                  ]
                },
                {
                  "required": [
                    "depth"
                  ]
                }
              ]
            }
          },
          "ground_truth": {
            "properties": {
              "timing": {
                "required": [
                  "lag_subframes",
                  "subframe_weights"
                ]
              }
            }
          },
          "internal": {
            "required": [
              "thermal"
            ]
          }
        }
      }
    }
  ]
}
