{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/event/1/brief.v1.schema.json",
  "title": "Task brief brief.json (drone4d.event_brief.v1)",
  "description": "M23-FR-009 (contracts 1.3.0, d1 V0.3). Not truth: references only anchors the author marked public and appearance descriptions, never times or routes. M26 projects it into the agent configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.event_brief.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "truth_rev": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "reid_occlusion",
        "rendezvous_handoff",
        "vehicle_track",
        "target_search"
      ]
    },
    "public_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "pos_enu_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "pos_enu_m"
        ]
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": "string"
          },
          "description_zh": {
            "type": "string"
          },
          "description_en": {
            "type": "string"
          }
        },
        "required": [
          "actor"
        ]
      }
    },
    "task_area": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 3,
      "maxItems": 64,
      "description": "World-frame polygon (m)"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "description": "target_search only (M23 §15.3 rule 2, FR-083): the prior, search area, motion and window; never the actual position",
      "properties": {
        "target_class": {
          "enum": [
            "person",
            "vehicle",
            "object"
          ]
        },
        "prior": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "gmm",
                "grid"
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "description": "Isotropic Gaussian component; exactly one of anchor and xy (compile gate 1)",
                "properties": {
                  "anchor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Anchor id (awr-anchors@1)"
                  },
                  "xy": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "sigma_m": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 500
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  }
                },
                "required": [
                  "sigma_m"
                ]
              },
              "minItems": 1,
              "maxItems": 16
            },
            "grid": {
              "type": "object",
              "additionalProperties": false,
              "description": "Row-major (y outer, x inner) prior mass per cell",
              "properties": {
                "origin_xy": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "cell_m": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 100
                },
                "nx": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "ny": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "weights": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "maxItems": 65536
                }
              },
              "required": [
                "origin_xy",
                "cell_m",
                "nx",
                "ny",
                "weights"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        "area_polygon": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 64,
          "description": "World-frame polygon (m), simple, 3-64 vertices"
        },
        "motion": {
          "enum": [
            "static",
            "wander"
          ]
        },
        "wander_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "target_class",
        "prior",
        "area_polygon",
        "motion",
        "window_s"
      ]
    }
  },
  "required": [
    "schema",
    "event_id",
    "event_version",
    "truth_rev",
    "event_type",
    "public_anchors",
    "targets",
    "task_area"
  ]
}
