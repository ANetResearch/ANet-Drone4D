{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/event/1/appearance_lib.v1.schema.json",
  "title": "Appearance library (drone4d.appearance_lib.v1)",
  "description": "AWR-05 §5.2.8, §8.1 and ADR-181; M23 §15.2 and M23-FR-072; M25 §15.7 (contracts 1.3.0, d1 V0.3, P0b). appearance_lib@1 is a project-original procedural library generated deterministically from configs/appearance.d3/spec.yaml: each entry carries an id, a class, categorical attributes and their integer vector, procedural asset parameters, animation clips, thermal material zones, a descriptor embedding and a licence record. Event actors reference entries through actors[].appearance_ref; compile gate 1 checks target and distractor distinguishability with the attribute vector only (rules), the embedding is a diagnostic and is never delivered to agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lib_id",
    "generator",
    "license",
    "palette",
    "classes",
    "rules",
    "entries"
  ],
  "$defs": {
    "rgb": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spdx",
        "holder"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original",
            "third_party"
          ],
          "description": "original: made by the project, no external licence obligations"
        },
        "spdx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attribution": {
          "type": "string",
          "maxLength": 256
        },
        "third_party": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "spdx"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128
              },
              "spdx": {
                "type": "string",
                "maxLength": 128
              },
              "source": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "kind": {
          "enum": [
            "color",
            "enum"
          ],
          "description": "color values are palette keys"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "min_distance",
        "min_shared"
      ],
      "properties": {
        "class": {
          "enum": [
            "person",
            "vehicle"
          ]
        },
        "min_distance": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum attribute (Hamming) distance between the target and every distractor"
        },
        "min_shared": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of equal attributes (hard negatives)"
        },
        "shared_any_of": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "At least one of these attributes must be equal"
        }
      }
    },
    "cls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min_pair_distance",
        "attributes",
        "asset"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "min_pair_distance": {
          "type": "integer",
          "minimum": 1
        },
        "asset": {
          "type": "string"
        },
        "rig": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "drone4d.appearance_lib.v1"
    },
    "lib_id": {
      "type": "string",
      "pattern": "^appearance_lib@[1-9][0-9]*$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "spec_sha256",
        "seed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spec_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the RFC 8785 (JCS) form of the parsed spec"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "embedding_model": {
          "type": "string"
        },
        "rounds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "description": "Redraw round per class (0 = first draw); a round > 0 appends |r<round> to the counter key"
        }
      }
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rgb",
          "zh",
          "en"
        ],
        "properties": {
          "rgb": {
            "$ref": "#/$defs/rgb"
          },
          "zh": {
            "type": "string"
          },
          "en": {
            "type": "string"
          }
        }
      }
    },
    "min_delta_e00": {
      "type": "number",
      "minimum": 0
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person": {
          "$ref": "#/$defs/cls"
        },
        "vehicle": {
          "$ref": "#/$defs/cls"
        }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "reid_occlusion",
          "rendezvous_handoff",
          "vehicle_track",
          "target_search"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "min_hard_negatives": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "attrs",
          "vector",
          "asset",
          "size_m",
          "anim_clips",
          "thermal_zones",
          "embedding",
          "description",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+-[0-9]{2,4}$"
          },
          "class": {
            "enum": [
              "person",
              "vehicle"
            ]
          },
          "attrs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 8,
            "description": "Index of each attribute value in classes.<class>.attributes order"
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "generator",
              "render"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "procedural",
                  "gltf"
                ]
              },
              "generator": {
                "type": "string",
                "description": "Procedural proxy generator id (M25 FR-034) or glTF asset id"
              },
              "rig": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "render": {
                "type": "object",
                "additionalProperties": false,
                "description": "Visible-light parameters of the procedural proxy",
                "properties": {
                  "top_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "bottom_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "skin_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "body_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "roof_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "glass_rgb": {
                    "$ref": "#/$defs/rgb"
                  },
                  "pattern": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "solid",
                          "striped",
                          "checked"
                        ]
                      },
                      "accent_rgb": {
                        "$ref": "#/$defs/rgb"
                      },
                      "period_m": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  },
                  "accessory": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "none",
                          "backpack",
                          "cap",
                          "shoulder_bag"
                        ]
                      },
                      "rgb": {
                        "$ref": "#/$defs/rgb"
                      }
                    }
                  },
                  "roof_rack": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rgb"
                    ],
                    "properties": {
                      "rgb": {
                        "$ref": "#/$defs/rgb"
                      }
                    }
                  },
                  "marking": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "none",
                          "side_stripe",
                          "door_panel"
                        ]
                      },
                      "rgb": {
                        "$ref": "#/$defs/rgb"
                      }
                    }
                  },
                  "body_type": {
                    "enum": [
                      "sedan",
                      "hatchback",
                      "suv",
                      "van",
                      "pickup"
                    ]
                  }
                }
              }
            }
          },
          "size_m": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 12
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "l, w, h in metres"
          },
          "gait": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speed_mps",
              "median_mps"
            ],
            "properties": {
              "speed_mps": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 40
                },
                "minItems": 2,
                "maxItems": 2
              },
              "median_mps": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "anim_clips": {
            "type": "array",
            "maxItems": 255,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "loop",
                "period_s"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "Clip id carried by the tape.anim sidecar (u8)"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "loop": {
                  "type": "boolean"
                },
                "period_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "thermal_zones": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zone",
                "emissivity",
                "temp_model"
              ],
              "properties": {
                "zone": {
                  "enum": [
                    "skin",
                    "clothing",
                    "body",
                    "engine",
                    "exhaust",
                    "glass"
                  ]
                },
                "emissivity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "temp_model": {
                  "type": "string",
                  "description": "Temperature model id of the M25 thermal_table_v1"
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "embedding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "values"
            ],
            "description": "Offline appearance embedding for gate-1 diagnostics and evaluation; never delivered to agents",
            "properties": {
              "model": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1,
                "maxItems": 512
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "description": "Canonical description generated from the attribute vector (M23-FR-083); no identity, route or time",
            "properties": {
              "zh": {
                "type": "string",
                "maxLength": 256
              },
              "en": {
                "type": "string",
                "maxLength": 256
              }
            }
          },
          "ref_image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "sha256"
            ],
            "description": "Reference appearance image rendered offline by M25 (brief content, not truth)",
            "properties": {
              "uri": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "views": {
                "type": "array",
                "items": {
                  "enum": [
                    "front",
                    "side",
                    "top45"
                  ]
                }
              }
            }
          },
          "license": {
            "$ref": "#/$defs/license"
          }
        }
      }
    }
  }
}
