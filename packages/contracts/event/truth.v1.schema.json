{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/event/1/truth.v1.schema.json",
  "title": "Semantic event truth event_truth.json (drone4d.event_truth.v1)",
  "description": "M23 §6.10.1 (contracts 1.3.0, d1 V0.3). Truth layer: evaluators and admins only. truth_sha256 = JCS hash without perf. v1.3 (M23 §15.3, FR-077; P0b, additive): key_events, key_relations, validator_params and report_map are written only for event types with a registered type validator.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.event_truth.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "truth_rev": {
      "type": "integer",
      "minimum": 1
    },
    "tape_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dsl_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strict": {
      "type": "boolean"
    },
    "detector_params": {
      "type": "object",
      "description": "All detector parameters in effect, defaults included"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "interval_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "declared": {
            "type": "boolean"
          },
          "annotation": {
            "type": "string"
          },
          "salience": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "in_incomplete_region": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_dist_m": {
                "type": "number"
              },
              "door": {
                "type": "string"
              },
              "door_dist_m": {
                "type": "number"
              },
              "sky_vis_min": {
                "type": "number"
              },
              "zone": {
                "type": "string"
              },
              "object": {
                "type": "string",
                "description": "Carried object actor id (object_handover)"
              },
              "dist_m": {
                "type": "number",
                "description": "Giver-receiver distance at the transfer, maximum of release and pickup frames (object_handover)"
              },
              "gap_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Release-to-pickup gap; 0 for a direct handover (object_handover)"
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "type",
          "participants",
          "interval_ms",
          "declared",
          "salience",
          "in_incomplete_region",
          "evidence"
        ]
      }
    },
    "annotation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "window_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "verified": {
            "type": "boolean"
          },
          "computed_ms": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "n_candidates": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "type",
          "window_ms",
          "verified",
          "computed_ms",
          "n_candidates"
        ]
      }
    },
    "relation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "dst": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "src",
          "rel",
          "dst",
          "verified"
        ]
      }
    },
    "skyvis_1hz": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Per actor, 3 decimals"
    },
    "consistency": {
      "type": "object",
      "description": "M23 §6.9.4 statistics and worst values"
    },
    "key_events": {
      "type": "array",
      "description": "Key events computed by the type validator from the tape (M23 §15.3 column 3, FR-077); authored declarations are only cross-checked",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "interval_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "window_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "declared": {
            "type": "boolean",
            "description": "True when the key event derives from a declared truth event"
          },
          "ref": {
            "type": "string",
            "description": "Id of the events[] row the key event derives from, if any"
          },
          "params": {
            "type": "object",
            "description": "Type-specific evidence, e.g. giver, receiver and object of a handover"
          }
        },
        "required": [
          "id",
          "type",
          "participants",
          "interval_ms",
          "params"
        ]
      }
    },
    "key_relations": {
      "type": "array",
      "description": "Relation edges between key events produced by the type validator; each holds by construction under the gate-3 relation predicates",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "rel": {
            "enum": [
              "before",
              "after",
              "during",
              "overlaps",
              "causes",
              "enables"
            ]
          },
          "dst": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "rel",
          "dst"
        ]
      }
    },
    "validator_params": {
      "type": "object",
      "description": "Type validator thresholds in effect, defaults included; part of truth_sha256 (M23 §15.3 rule 1)"
    },
    "report_map": {
      "type": "object",
      "description": "Agent report type to the key event types it matches (key_relations for relation reports), used by EU matching (M23 §15.3 rule 4, AWR-05 §5.2.8 rule 5)",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "perf": {
      "type": "object",
      "description": "Ray counts and timings; excluded from truth_sha256"
    }
  },
  "required": [
    "schema",
    "event_id",
    "event_version",
    "truth_rev",
    "tape_content_sha256",
    "dsl_sha256",
    "strict",
    "detector_params",
    "events",
    "annotation_checks",
    "relation_checks",
    "skyvis_1hz",
    "consistency"
  ]
}
