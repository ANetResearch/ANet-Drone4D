{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/event/1/graph.v1.schema.json",
  "title": "Event graph event_graph.json (drone4d.event_graph.v1)",
  "description": "M23 §6.10.2 (contracts 1.3.0, d1 V0.3). Entity and event nodes; participates_in edges plus verified relation edges. OpenLABEL mapping is P3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.event_graph.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "truth_rev": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "entity"
              },
              "class": {
                "type": "string"
              },
              "scripted": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "class",
              "scripted"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "event"
              },
              "type": {
                "type": "string"
              },
              "interval_ms": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "declared": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "type",
              "interval_ms",
              "declared"
            ]
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "rel": {
            "enum": [
              "participates_in",
              "before",
              "after",
              "during",
              "overlaps",
              "causes",
              "enables"
            ]
          },
          "dst": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "rel",
          "dst"
        ]
      }
    }
  },
  "required": [
    "schema",
    "event_id",
    "event_version",
    "truth_rev",
    "nodes",
    "edges"
  ]
}
