{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/event/1/tape_manifest.v1.schema.json",
  "title": "Tape manifest tape.json (drone4d.tape_manifest.v1)",
  "description": "M23 §6.7.6 (contracts 1.3.0, d1 V0.3). Not part of the content hash; the header in tape.bin is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "drone4d.tape_manifest.v1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "header_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Transport check only"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "n_actors": {
      "type": "integer",
      "minimum": 0
    },
    "n_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "header": {
      "$ref": "tape.v1.schema.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string"
        },
        "generator_version": {
          "type": "string"
        },
        "recast_navigation": {
          "type": "string"
        },
        "wasm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "node": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "rss_mb": {
          "type": "number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "recast_navigation",
        "wasm_sha256",
        "node",
        "host",
        "wall_ms",
        "rss_mb",
        "created_at"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrivals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actor": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "t_plan_s": {
                "type": "number"
              },
              "t_arrive_s": {
                "type": "number"
              },
              "late_s": {
                "type": "number"
              }
            },
            "required": [
              "actor",
              "at",
              "t_plan_s",
              "t_arrive_s",
              "late_s"
            ]
          }
        },
        "boards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_dist_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scripted_scripted": {
              "type": [
                "number",
                "null"
              ]
            },
            "bg_scripted": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "scripted_scripted",
            "bg_scripted"
          ]
        }
      },
      "required": [
        "arrivals",
        "boards",
        "warnings",
        "min_dist_m"
      ]
    }
  },
  "required": [
    "schema",
    "content_sha256",
    "body_sha256",
    "header_sha256",
    "file_sha256",
    "bytes",
    "n_actors",
    "n_ticks",
    "header",
    "provenance",
    "report"
  ]
}
