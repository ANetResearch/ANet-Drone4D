{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/tasking/1/task.schema.json",
  "title": "awr.tasking.task.v1 (task object, request and dry-run preview)",
  "description": "Task object of GET .../tasks/{tid} (AWR-17 §17.6.7; M20 §6.2.2); $defs/request is the create and dry-run body (task/create), $defs/preview the dry-run reply awr.tasking.preview.v1. Infeasible: 580 (why height, fleet_short, single_station_far_view, no_capability, energy, range, area_empty), 581, 585.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tid": {
      "$ref": "../../world/1/common.schema.json#/$defs/slug"
    },
    "type": {
      "enum": [
        "point_watch",
        "polyline_patrol",
        "area_patrol",
        "area_scan_gsd",
        "perimeter_patrol",
        "relay_watch",
        "area_guard"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "PLANNING",
        "READY",
        "RUNNING",
        "PAUSED",
        "DONE",
        "CANCELED",
        "FAILED",
        "INFEASIBLE"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "params": {
      "type": "object"
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "start_at_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "unit": "s"
        },
        "allowed_nests": {
          "type": "array",
          "items": {
            "$ref": "../../world/1/common.schema.json#/$defs/slug"
          }
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          }
        },
        "on_detect": {
          "enum": [
            "notify",
            "relay",
            "ignore"
          ]
        },
        "allocator": {
          "type": "string"
        },
        "external_fallback": {
          "enum": [
            "greedy",
            "none"
          ]
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "unit %"
        },
        "coverage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "unit": "%"
        },
        "laps_done": {
          "type": "integer",
          "minimum": 0
        },
        "dwell_s": {
          "type": "number",
          "minimum": 0,
          "unit": "s"
        }
      }
    },
    "n_vehicles": {
      "type": "integer",
      "minimum": 0
    },
    "makespan_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "unit": "s"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wid": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          },
          "kind": {
            "type": "string"
          },
          "uav": {
            "oneOf": [
              {
                "$ref": "../../world/1/common.schema.json#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string"
          },
          "eta_s": {
            "type": [
              "number",
              "null"
            ],
            "unit": "s"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "wid",
          "kind",
          "state"
        ]
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "../../world/1/common.schema.json#/$defs/slug"
      }
    },
    "parent": {
      "oneOf": [
        {
          "$ref": "../../world/1/common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_t_sim_ns": {
      "$ref": "../../world/1/common.schema.json#/$defs/int64"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    }
  },
  "required": [
    "tid",
    "type",
    "state",
    "revision",
    "params"
  ],
  "$defs": {
    "params_point_watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 2,
          "maxItems": 3
        },
        "alt_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 500,
          "unit": "m"
        },
        "alt_ref": {
          "enum": [
            "agl",
            "abs"
          ]
        },
        "dwell_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "unit": "s"
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "point",
                "heading",
                "target"
              ]
            },
            "point": {
              "$ref": "../../world/1/common.schema.json#/$defs/vec3"
            },
            "heading_rad": {
              "type": "number",
              "unit": "rad"
            },
            "target": {
              "$ref": "../../world/1/common.schema.json#/$defs/slug"
            }
          },
          "required": [
            "mode"
          ]
        },
        "loiter_radius_m": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000,
          "unit": "m"
        }
      },
      "required": [
        "point"
      ]
    },
    "params_polyline_patrol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waypoints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 64
        },
        "mode": {
          "enum": [
            "once",
            "pingpong",
            "loop"
          ]
        },
        "laps": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "speed_mps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "unit": "m/s"
        },
        "alt_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 500,
          "unit": "m"
        },
        "sensor_facing": {
          "enum": [
            "down",
            "forward",
            "side"
          ]
        },
        "auto_detour": {
          "type": "boolean"
        }
      },
      "required": [
        "waypoints"
      ]
    },
    "params_area_patrol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "../../world/1/common.schema.json#/$defs/vec2"
          },
          "minItems": 3,
          "maxItems": 64,
          "description": "World ENU m, counter-clockwise, area <= 1 km^2"
        },
        "n_vehicles": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          ]
        },
        "target_class": {
          "type": "string"
        },
        "level_req": {
          "enum": [
            "D",
            "R",
            "I"
          ]
        },
        "revisit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "theta_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "unit": "deg"
        },
        "sidelap": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "alt_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 500,
          "unit": "m"
        }
      },
      "required": [
        "polygon"
      ]
    },
    "params_area_scan_gsd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "../../world/1/common.schema.json#/$defs/vec2"
          },
          "minItems": 3,
          "maxItems": 64,
          "description": "World ENU m, counter-clockwise, area <= 1 km^2"
        },
        "gsd_cm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "cm"
        },
        "sidelap": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "frontlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "theta_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "unit": "deg"
        },
        "t_max_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "h_cap_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "m"
        },
        "clearance_m": {
          "type": "number",
          "minimum": 0,
          "unit": "m"
        },
        "allow_multi_sortie": {
          "type": "boolean"
        },
        "n_vehicles": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          ]
        },
        "strategy": {
          "enum": [
            "strips",
            "single_station"
          ]
        }
      },
      "required": [
        "polygon",
        "gsd_cm"
      ]
    },
    "params_perimeter_patrol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "../../world/1/common.schema.json#/$defs/vec2"
          },
          "minItems": 3,
          "maxItems": 64,
          "description": "World ENU m, counter-clockwise, area <= 1 km^2"
        },
        "offset_m": {
          "type": "number",
          "unit": "m"
        },
        "direction": {
          "enum": [
            "cw",
            "ccw"
          ]
        },
        "revisit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "n_vehicles": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          ]
        },
        "alt_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 500,
          "unit": "m"
        }
      },
      "required": [
        "polygon"
      ]
    },
    "params_relay_watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "../../world/1/common.schema.json#/$defs/slug"
        },
        "level_req": {
          "enum": [
            "D",
            "R",
            "I"
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "unit": "s"
        }
      },
      "required": [
        "target"
      ]
    },
    "params_area_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "../../world/1/common.schema.json#/$defs/vec2"
          },
          "minItems": 3,
          "maxItems": 64,
          "description": "World ENU m, counter-clockwise, area <= 1 km^2"
        },
        "target_class": {
          "type": "string"
        },
        "level_req": {
          "enum": [
            "D",
            "R",
            "I"
          ]
        },
        "revisit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "unit": "s"
        },
        "perimeter_offset_m": {
          "type": "number",
          "unit": "m"
        }
      },
      "required": [
        "polygon"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "point_watch",
            "polyline_patrol",
            "area_patrol",
            "area_scan_gsd",
            "perimeter_patrol",
            "relay_watch",
            "area_guard"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "params": {
          "type": "object"
        },
        "common": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "priority": {
              "enum": [
                "low",
                "normal",
                "high"
              ]
            },
            "start_at_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "unit": "s"
            },
            "allowed_nests": {
              "type": "array",
              "items": {
                "$ref": "../../world/1/common.schema.json#/$defs/slug"
              }
            },
            "allowed_models": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,40}$"
              }
            },
            "on_detect": {
              "enum": [
                "notify",
                "relay",
                "ignore"
              ]
            },
            "allocator": {
              "type": "string"
            },
            "external_fallback": {
              "enum": [
                "greedy",
                "none"
              ]
            }
          }
        },
        "preview_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^pv-[a-z2-7]{8}$"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "point_watch"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_point_watch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "polyline_patrol"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_polyline_patrol"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "area_patrol"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_area_patrol"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "area_scan_gsd"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_area_scan_gsd"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "perimeter_patrol"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_perimeter_patrol"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "relay_watch"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_relay_watch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "area_guard"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_area_guard"
              }
            }
          }
        }
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preview_id": {
          "type": "string",
          "pattern": "^pv-[a-z2-7]{8}$"
        },
        "valid_until_unix_ns": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "UNIX time in ns as a decimal string (AWR-17 §1.3)"
        },
        "n_vehicles": {
          "type": "integer",
          "minimum": 0
        },
        "makespan_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "unit": "s"
        },
        "t_max_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "unit": "s"
        },
        "why_n": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rule": {
              "enum": [
                "makespan",
                "fleet_short",
                "user_fixed"
              ]
            },
            "n_minus_1_makespan_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "unit": "s"
            }
          },
          "required": [
            "rule"
          ]
        },
        "makespan_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "makespan_s": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "unit": "s"
              }
            },
            "required": [
              "n",
              "makespan_s"
            ]
          }
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "h_m": {
              "type": "number",
              "unit": "m"
            },
            "f_mm": {
              "type": "number",
              "unit": "mm"
            },
            "p_eff_um": {
              "type": "number",
              "unit": "um"
            },
            "strip_w_m": {
              "type": "number",
              "unit": "m"
            },
            "spacing_m": {
              "type": "number",
              "unit": "m"
            },
            "n_strips": {
              "type": "integer",
              "minimum": 0
            },
            "theta_e_deg": {
              "type": "number",
              "unit": "deg"
            },
            "footprint_bound_m": {
              "type": "number",
              "unit": "m"
            },
            "h_floor_m": {
              "type": "number",
              "unit": "m"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direct_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            },
            "visible_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            },
            "fill_waypoints": {
              "type": "integer",
              "minimum": 0
            },
            "obstacle_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "unit": "%"
            },
            "cells": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "uav": {
                "$ref": "../../world/1/common.schema.json#/$defs/slug"
              },
              "nest": {
                "oneOf": [
                  {
                    "$ref": "../../world/1/common.schema.json#/$defs/slug"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "wid": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
                    },
                    "kind": {
                      "enum": [
                        "strip_group",
                        "subregion",
                        "segment",
                        "station",
                        "dwell",
                        "look_in",
                        "relay_station",
                        "perimeter_phase",
                        "guard_cycle",
                        "fill"
                      ]
                    },
                    "ref": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "wid",
                    "kind"
                  ]
                }
              },
              "eta_s": {
                "type": "number",
                "minimum": 0,
                "unit": "s"
              },
              "energy_margin": {
                "type": "number"
              }
            },
            "required": [
              "uav",
              "items"
            ]
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subregions": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "../../world/1/common.schema.json#/$defs/vec2"
                }
              }
            },
            "strips": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "p0": {
                    "$ref": "../../world/1/common.schema.json#/$defs/vec3"
                  },
                  "p1": {
                    "$ref": "../../world/1/common.schema.json#/$defs/vec3"
                  },
                  "uav": {
                    "oneOf": [
                      {
                        "$ref": "../../world/1/common.schema.json#/$defs/slug"
                      },
                      {
                        "type": "null"
                      }
                    ]
