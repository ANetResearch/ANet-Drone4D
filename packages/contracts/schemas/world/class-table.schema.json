{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/world/1/class-table.schema.json",
  "title": "Point class table anet-classes@N (compact runtime index <-> ASPRS LAS 1.4 code)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "classes",
    "unmappedLasCodeIndex"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "key",
          "lasCode",
          "name"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "lasCode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255,
            "description": "Code written to LAS/COPC/3D Tiles exports. null = reserved slot."
          },
          "alsoFrom": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "description": "Extra LAS codes collapsed into this index on import."
          },
          "name": {
            "type": "string"
          },
          "nameZh": {
            "type": "string"
          },
          "colorToken": {
            "type": "string",
            "description": "Design token (d01 ANet Graphite / brand red) used by the Class colour mode."
          },
          "defaultVisible": {
            "type": "boolean"
          },
          "pseudoReflectance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Pseudo intensity rho for synthetic data and LiDAR mock (x01 §3.7)."
          }
        }
      }
    },
    "unmappedLasCodeIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "Index used for any LAS code not listed (counted in QA)."
    }
  },
  "description": "AWR-16 §5. The runtime byte col.a stores index; exports store lasCode. semantic/anet-classes@1.json must equal packages/contracts/classes/anet-classes-v1.json byte for byte (V-K-04)."
}
