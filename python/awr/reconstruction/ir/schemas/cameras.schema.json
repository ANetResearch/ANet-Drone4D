{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/recon/1/cameras.schema.json",
  "title": "Recon IR cameras.json (awr.recon.cameras.v1)",
  "description": "M01 §6.3.1: COLMAP camera models, params in COLMAP order, original-image pixels, COLMAP pixel centres (+0.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ir_version",
    "cameras"
  ],
  "properties": {
    "schema": {
      "const": "awr.recon.cameras.v1"
    },
    "ir_version": {
      "const": "1.0.0"
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera_id",
          "model",
          "width",
          "height",
          "params",
          "source",
          "pixel_convention"
        ],
        "properties": {
          "camera_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "model": {
            "enum": [
              "SIMPLE_PINHOLE",
              "PINHOLE",
              "SIMPLE_RADIAL",
              "RADIAL",
              "OPENCV",
              "OPENCV_FISHEYE",
              "FULL_OPENCV"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "params": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "source": {
            "enum": [
              "calibrated",
              "predicted",
              "synthetic"
            ]
          },
          "pixel_convention": {
            "const": "colmap"
          }
        }
      }
    }
  }
}
