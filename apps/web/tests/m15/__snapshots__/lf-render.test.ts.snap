exports[`lieflat static figures > stat and chart card keep the four-part structure 1`] = `"<div data-slot="card" data-size="sm" class="group/card flex flex-col overflow-hidden bg-card py-(--card-spacing) text-xs/relaxed text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)] has-[&gt;img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(3)] *:[img:first-child]:rounded-t-lg *:[img:last-child]:rounded-b-lg gap-2 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-ring" data-lf-card="hud" data-figure="test-card" tabindex="0"><div data-slot="card-header" class="group/card-header @container/card-header grid auto-rows-min items-start rounded-t-lg px-(--card-spacing) has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] [.border-b]:pb-(--card-spacing) gap-0.5"><div data-slot="card-title" class="text-hud-title font-semibold">Shenzhen has the most points</div><div data-slot="card-description" class="text-muted-foreground text-hud-sub">6 worlds</div></div><div data-slot="card-content" class="px-(--card-spacing) relative"><div data-lf-stat="" class="flex items-end justify-between gap-2"><div class="flex min-w-0 flex-col gap-0.5"><span class="truncate text-hud-cap font-semibold uppercase text-muted-foreground">POINTS</span><span class="flex items-baseline gap-1"><span data-numeric="" class="text-hud-kpi font-extrabold">4.82M</span></span></div></div></div><div data-slot="card-footer" class="flex items-center rounded-b-lg px-(--card-spacing) [.border-t]:pt-(--card-spacing)"><span data-lf-src="" class="font-medium uppercase text-muted-foreground text-hud-cap">WORLD MANIFESTS</span></div></div>"`;

