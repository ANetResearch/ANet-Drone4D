{
  "name": "@awr/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWR 前端（Vite 8 + React 19.3 + TS 7）；依赖增删向 M00 提交请求，版本以 AWR-11 §3.2、§3.6 为准",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "test": "vitest run --project unit --project browser --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:browser": "vitest run --project browser --passWithNoTests",
    "bench": "vitest bench --run --passWithNoTests",
    "perf:flight60": "node perf/harness/run.mjs --case flight60",
    "perf:layers": "node perf/harness/run.mjs --case layers",
    "perf:ladder": "node perf/harness/run.mjs --case ladder",
    "perf:feat-matrix": "node perf/harness/run.mjs --case feat-matrix",
    "perf:quality": "node perf/harness/run.mjs --case quality",
    "perf:latency": "node perf/harness/run.mjs --case latency",
    "perf:storm": "node perf/harness/run.mjs --case storm",
    "perf:governor": "node perf/harness/run.mjs --case governor",
    "perf:converge": "node perf/harness/run.mjs --case converge",
    "perf:soak": "node perf/harness/run.mjs --case soak",
    "perf:ui": "node perf/harness/run.mjs --case ui",
    "perf:net": "node perf/harness/run.mjs --case net",
    "perf:report": "node perf/harness/run.mjs --case report"
  },
  "dependencies": {
    "@awr/contracts": "1.0.0",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@msgpack/msgpack": "3.1.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "camera-controls": "3.1.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide": "1.48.0",
    "morphicons": "1.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.1",
    "stats-gl": "4.2.3",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@voxelkloud/react": "0.6.0",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "oxc-parser": "0.151.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "potree-core": "2.0.15",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-scan": "0.5.7",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
