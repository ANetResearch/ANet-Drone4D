{
  "name": "anet-drone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANet Drone / World Runtime（AWR）npm workspaces 根清单（M00）",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "perf:flight60": "npm run perf:flight60 -w apps/web --",
