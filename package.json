    "perf:layers": "npm run perf:layers -w apps/web --",
    "perf:feat-matrix": "npm run perf:feat-matrix -w apps/web --"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "@voxelkloud/react": {
      "three": "0.186.1"
    },
    "@voxelkloud/view": {
      "three": "0.186.1"
    }
  }
}
