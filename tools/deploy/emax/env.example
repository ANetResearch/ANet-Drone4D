# /etc/anet-drone4d/env：ANet Drone4D 公开演示站（T4，AWR-19 §3.7；ADR-082、ADR-085）的运行环境。
# install.sh 首次安装时由本文件生成（0600 root:root；systemd 以 root 读取后降权为 awr 启动 supervisor），之后不再覆盖。
# 本文件只放非机密配置；任何机密都不写在这里，也绝不入库：管理口令由 `install.sh --admin-secret` 在服务器上随机生成到
# /etc/anet-drone4d/admin.secret（0600 awr），每个 run 的签名密钥由 supervisor 在 var/runs/<run>/secret 自动生成。
# 格式为 systemd EnvironmentFile：KEY=VALUE，不展开变量，# 开头为注释。

# ---- 运行形态（必填） ---------------------------------------------------------------------------------------------
# public profile（configs/runtime.yaml）：只起 sim-core 与 api；recorder、agent-runtime、job-worker 关闭；热备用与钉核关闭；
# 世界 synthcity、剧本 s0-synthcity-showcase 的 public 剧本 profile（不录制、结束后自动从头重开并轮换天气）。
AWR_PROFILE=public

# 浏览器 Origin 白名单（逗号分隔的精确 origin）。公开模式只认这里列出的 origin，回环 origin 也不例外：
# 经 SSH 转发排查时临时追加 http://127.0.0.1:18640 并重启服务，排查完删掉。
AWR_ORIGINS=https://drone4d.agentnetwork.org.cn

# Host 白名单（防 DNS 重绑定）：localhost 与 127.0.0.1 永远允许，这里补上站点域名。
AWR_ALLOWED_HOSTS=drone4d.agentnetwork.org.cn

# 可信反向代理（IP 或 CIDR）：来自这些地址的请求按 X-Forwarded-For 取客户端地址，只用于限流与日志，不参与鉴权。
# nginx 与 api 在同一台机器上，保持回环即可。
AWR_TRUSTED_PROXIES=127.0.0.1,::1

# ---- 目录（与 install.sh 的布局一致；放在发布目录之外，回滚与升级不丢数据） ------------------------------------------
# World Package 目录：只放 synthcity 与共享环境资产 _shared（UrbanScene3D 六城禁止再分发，公开站不得放入）。
AWR_WORLDS_DIR=/opt/anet-drone4d/var/worlds
# 运行目录（每次启动一个 run：日志、审计、生效配置）；配额见 AWR_RUNS_QUOTA_GB。
AWR_RUNS_DIR=/opt/anet-drone4d/var/runs
AWR_RUNS_QUOTA_GB=2
# numba 编译缓存：install.sh 安装时预热，sim-core 启动时只读缓存（缓存缺失会在主循环内编译并触发挂死重启）。
NUMBA_CACHE_DIR=/opt/anet-drone4d/var/cache/numba
HOME=/opt/anet-drone4d
PYTHONDONTWRITEBYTECODE=1

# ---- 可选覆盖（缺省取 public profile 的值，一般不需要改） ------------------------------------------------------------
# api 监听端口（只监听 127.0.0.1，由 nginx 反向代理；nginx 站点文件的 upstream 必须同步修改）
#AWR_PORT=18640
# WS 连接总数上限与每个客户端地址的上限（nginx 另有 limit_conn drone4d_ws 4）
#AWR_WS_MAX=64
#AWR_WS_MAX_PER_IP=4
# 世界白名单（逗号分隔）；公开站只能是 synthcity
#AWR_WORLDS_ALLOW=synthcity
# 管理口令文件：配置后才能签发 operator 与 admin（运维排查用，口令绝不写进本文件）。缺省不配置，一律拒绝。
#AWR_ADMIN_SECRET_FILE=/etc/anet-drone4d/admin.secret
# 前端构建目录（缺省为发布目录下 apps/web/dist，即 build-local.sh 打进包里的 VITE_AWR_DEMO=public 构建）
#AWR_WEB_DIST=/opt/anet-drone4d/current/apps/web/dist
