# /etc/anet-drone4d/env：ANet Drone4D 公开演示站 V0.2-demo（T4，AWR-19 §3.7；ADR-082、ADR-085、ADR-091、ADR-109、ADR-121、
# ADR-123）的运行环境。install.sh 首次安装时由本文件生成（0600 root:root；systemd 以 root 读取后降权为 awr 启动），之后不再
# 覆盖：升级时 install.sh 提示新增的键，请对照本文件手工合并。
# 本文件只放非机密配置；任何机密都不写在这里，也绝不入库：
#   - 内部身份口令（ADR-123）由运维在服务器上以 `install.sh --admin-secret-file <文件>` 写入 /etc/anet-drone4d/admin.secret
#     （0600 awr），install.sh 只在本文件中设置 AWR_ADMIN_SECRET_FILE 指向它；口令本身从不出现在本文件、部署包、仓库与日志中；
#   - 每个 run 的签名密钥由 supervisor 在 var/runs/<run>/secret 生成；沙盒的 token.key、pool.secret 由 sandbox-pool 在
#     var/sandbox/ 生成（0600）。
# 格式为 systemd EnvironmentFile：KEY=VALUE，不展开变量，# 开头为注释。

# ---- 运行形态（必填） ---------------------------------------------------------------------------------------------
# public profile v2（configs/runtime.yaml）：核心进程（sim-core、show-api）加沙盒控制面（sandbox-pool、sandbox-api）；
# recorder、agent-runtime、job-worker 关闭；热备用与钉核关闭；共享展示运行剧本 S7（接力监控，public 剧本 profile）；
# 七个世界（synthcity 与 UrbanScene3D 六城，后者经数据集权利方授权使用）在共享展示可静态浏览、在沙盒可创建与切换。
AWR_PROFILE=public

# 浏览器 Origin 白名单（逗号分隔的精确 origin）。公开模式只认这里列出的 origin，回环 origin 也不例外：
# 经 SSH 转发排查时临时追加 http://127.0.0.1:18640 并重启服务，排查完删掉。
AWR_ORIGINS=https://drone4d.agentnetwork.org.cn

# Host 白名单（防 DNS 重绑定）：localhost 与 127.0.0.1 永远允许，这里补上站点域名。
AWR_ALLOWED_HOSTS=drone4d.agentnetwork.org.cn

# 可信反向代理（IP 或 CIDR）：来自这些地址的请求按 X-Forwarded-For 取客户端地址，只用于限流、配额前缀与日志，不参与鉴权。
# nginx 与两个 api 在同一台机器上，保持回环即可。
AWR_TRUSTED_PROXIES=127.0.0.1,::1

# ---- 目录（与 install.sh 的布局一致；放在发布目录之外，回滚与升级不丢数据） ------------------------------------------
# World Package 目录：七个世界（install.sh --worlds 装入）、共享环境资产 _shared/env、构建状态 .status/ 与派生缓存
# .geo-cache/（M04，含 Grid25；缺省缓存根即 <本目录>/.geo-cache）。
AWR_WORLDS_DIR=/opt/anet-drone4d/var/worlds
# 运行目录（每次启动一个 run：日志、审计、生效配置）；配额见 AWR_RUNS_QUOTA_GB。沙盒的运行目录在 var/sandbox/runs/。
AWR_RUNS_DIR=/opt/anet-drone4d/var/runs
AWR_RUNS_QUOTA_GB=2
# numba 编译缓存：install.sh 安装时以共享展示与沙盒两套插件预热，sim-core 启动时只读缓存（缓存缺失会在主循环内编译并触发
# 挂死重启）。
NUMBA_CACHE_DIR=/opt/anet-drone4d/var/cache/numba
HOME=/opt/anet-drone4d
PYTHONDONTWRITEBYTECODE=1

# ---- 可选覆盖（缺省取 public profile 的值，一般不需要改） ------------------------------------------------------------
# show-api 监听端口（只监听 127.0.0.1，由 nginx 反向代理；nginx 站点文件的 upstream drone4d_backend 必须同步修改）
#AWR_PORT=18640
# 共享展示的 WS 连接总数上限（= 实时观看席位 V_max 的缺省值 ws_max_show，ADR-120）与每个地址前缀的上限
# （nginx 另有 limit_conn drone4d_ws_v2 4）
#AWR_WS_MAX=24
#AWR_WS_MAX_PER_IP=4
# 世界白名单（逗号分隔）。缺省为 public profile 的七个世界；D1 时期若在这里写过 AWR_WORLDS_ALLOW=synthcity，请删除该行
#AWR_WORLDS_ALLOW=synthcity,shenzhen,suzhou,newyork,chicago,shanghai,sanfrancisco

# 管理口令文件（内部身份，ADR-123；兼作 D1 operator 与 admin 的管理口令）：由 install.sh --admin-secret-file 或
# --admin-secret 写入并设置。未设置时内部身份入口返回"此部署未启用内部身份"，operator 与 admin 一律拒绝。
#AWR_ADMIN_SECRET_FILE=/etc/anet-drone4d/admin.secret

# 前端构建目录（缺省为发布目录下 apps/web/dist，即 build-local.sh 打进包里的 VITE_AWR_DEMO=public 构建）
#AWR_WEB_DIST=/opt/anet-drone4d/current/apps/web/dist

# ---- 沙盒（D2，M17；AWR-04 §4.4、§11.5） ------------------------------------------------------------------------
# 总开关：0 关闭沙盒（容量接口报 closed，落地页的"开启我的沙盒"置灰并说明；共享展示照常）。缺省开启。
#AWR_SANDBOX_ENABLED=1
# sandbox-api 端口（只监听 127.0.0.1；nginx 站点文件的 upstream drone4d_sandbox 必须同步修改）
#AWR_SANDBOX_PORT=18641
# 池状态目录（0700 awr）：token.key、pool.secret、state.json、audit.jsonl、runs/<sid>/、snapshots/、parked/<sid>/
#AWR_SANDBOX_STATE_DIR=/opt/anet-drone4d/var/sandbox
# 并发沙盒上限 N_max：auto 按 AWR-04 §4.4.1 公式由单元 CPUQuota 推出（250% 时 4、200% 时 2，硬上限 6，无 cgroup 委派时再减 1）；
# 运行中临时降容用 sbctl.sh limits --max-sessions n
#AWR_SANDBOX_MAX_SESSIONS=auto
# 世界加权内存准入额度 M_sb（MB）：cgroup-exec.sh 按 sandbox/memory.high − 控制面 200 MB 自动导出（MemoryHigh 1.8G 时 1100，
# 1.6G 时 950），这里设置时以这里为准
#AWR_SANDBOX_MEM_MB=1100
# 读不到单元 cpu.max 时的 Q（核）
#AWR_SANDBOX_CPU_QUOTA=2.5
# 派生缓存根（缺省 <AWR_WORLDS_DIR>/.geo-cache；与世界包分开放置时才需要设置）。沙盒 sim-core 与共享规划 worker 由池以
# AWR_GEO_ALLOW_DERIVE=0 启动：缓存缺失的世界在 GET /worlds 中为 available: false，绝不在线派生（AWR-04 §4.4.7）
#AWR_GEO_CACHE_DIR=/opt/anet-drone4d/var/worlds/.geo-cache

# ---- cgroup 布局（cgroup-exec.sh，AWR-04 §4.4.4；一般不需要改） ----------------------------------------------------
# 1 时跳过 cgroup 布局（按无委派运行：N_max − 1、nice +5、RSS 看门狗）
#AWR_CGROUP_DISABLE=0
# 共享展示的 CPU 预留 C_core（核），sandbox/cpu.max = 0.9·Q − C_core；或直接给出 sandbox/cpu.max（核）
#AWR_CG_C_CORE=0.89
#AWR_CG_SANDBOX_CPU_MAX=1.36
# 沙盒组内存（缺省按单元 MemoryHigh：1.8G 时 1300M 与 1450M，1.6G 时 1150M 与 1300M）
#AWR_CG_SANDBOX_MEM_HIGH=1300M
#AWR_CG_SANDBOX_MEM_MAX=1450M

# ---- 节能、观看席位与排队（D2.1，ADR-120、ADR-121；阈值以 configs/runtime.yaml 的 power:、viewer_seats:、sandbox.park:、
# sandbox.internal: 段为准，public profile 取下列缺省值，前端经容量接口与 serverInfo.power 取得同一组数值） ----------------
#   viewer 无交互 300 s（席位满且有人排队时 120 s）后节能并释放观看席位；沙盒 operator 无交互 600 s（队列非空时 300 s）后
#   驻留（checkpoint 落盘、释放槽位，保留 3600 s，恢复时可能需要排队）；页面隐藏 60 s 即节能；节能前 30 s 倒计时；
#   服务端兜底余量 90 s；无连接的沙盒 120 s（队列非空 60 s）驻留；观看席位 V_max = AWR_WS_MAX（24），观看排队 ≤ 100 人，
#   轮到者预留 30 s；内部身份另有 1 个预留沙盒槽位、寿命 8 h、节能阈值 3600 s。
# 以下环境变量覆盖待 M11 在配置加载器（awr.runtime.config 的环境变量表）登记后生效，在此之前设置不起作用：
#AWR_POWER_VIEWER_IDLE_S=300
#AWR_POWER_SANDBOX_IDLE_S=600
#AWR_POWER_HIDDEN_S=60
#AWR_POWER_WARN_S=30
#AWR_VIEWER_SEATS_MAX=auto
#AWR_VIEWER_QUEUE_MAX=100
#AWR_SANDBOX_PARK_RETENTION_S=3600
# 内部身份状态目录（锁定表 lockout.json 与撤销表 revoked.json，0700 awr；install.sh 已创建）
#AWR_IDENTITY_STATE_DIR=/opt/anet-drone4d/var/identity
