# dmax `d3` profile（内部工作区）部署参数（AWR-05 §7.11、ADR-166；AWR-17 §19；D3-AC-51）。profile.sh 与 labctl.sh 读取；
# 只含非密参数（bench token、k_bench 与 TLS 私钥只在 dmax 的 $LAB_DATA/keys 与 $LAB_ROOT/tls 中，0600，不入库、不输出）。
LAB_ROOT=${LAB_ROOT:-/data/anet-drone4d-d3/lab}               # 部署根：data/（数据根）、tls/、out/（核查记录）
LAB_DATA=${LAB_DATA:-$LAB_ROOT/data}                          # AWR_BENCH_DATA_ROOT（容器内以相同绝对路径挂载）
LAB_SEED=${LAB_SEED:-/data/anet-drone4d-d3/d3dev/benchroot}   # 初始化数据根时复制的榜单、提交与 Env 运行（只读来源）
LAB_CAPTURE=${LAB_CAPTURE:-/data/anet-drone4d-d3/d3dev/d3data} # 采集运行（raw.mcap、frames.idx）只读挂载并按运行链接进数据根
LAB_WORLDS=${LAB_WORLDS:-/data/anet-drone4d-d3/d3dev/worlds}  # D3 世界包（只读挂载，按世界链接进数据根 worlds/）
LAB_BIND=${LAB_BIND:-10.253.20.5}                             # dmax 的 ZeroTier 地址（网卡 zth6rfmmmy）；公网网卡不监听
LAB_PORT=${LAB_PORT:-18660}
LAB_SERVER_NAME=${LAB_SERVER_NAME:-dmax.anet.chat}
LAB_ORIGIN=${LAB_ORIGIN:-https://$LAB_BIND:$LAB_PORT}
LAB_ORIGINS=${LAB_ORIGINS:-https://$LAB_BIND:$LAB_PORT,https://$LAB_SERVER_NAME:$LAB_PORT}
LAB_UID=${LAB_UID:-10001}
LAB_TAG=${LAB_TAG:-current}
LAB_PUBLIC_IP=${LAB_PUBLIC_IP:-}                              # dmax 公网地址（端口扫描对象）；缺省在扫描时取 dmax 缺省路由的源地址
