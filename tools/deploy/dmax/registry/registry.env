# d3-registry（私有镜像仓库）部署参数（AWR-05 §5.6.7、§5.6.8、ADR-183；AWR-17 §18.23；D3-AC-59）。regctl.sh 读取；只含非密参数。
# 与内部工作区（../lab/lab.env）共用 ZeroTier 地址、TLS 证书（SAN 含 $LAB_BIND）、数据根（bench token 表、k_bench 与审计目录）与 uid。
# shellcheck source=../lab/lab.env
. "$(dirname "${BASH_SOURCE[0]}")/../lab/lab.env"
REG_ROOT=${REG_ROOT:-/data/anet-drone4d-d3/registry}          # 部署根：data/（仓库存储）、conf/（配置与 authz.py）、out/（核查记录）、drill/
REG_BIND=${REG_BIND:-$LAB_BIND}                               # 只监听 ZeroTier 地址（与 lab-web 相同，公网网卡不监听）
REG_PORT=${REG_PORT:-18670}                                   # d3-registry-front（nginx，TLS）
REG_BACKEND_PORT=${REG_BACKEND_PORT:-18671}                   # d3-registry（distribution，只绑回环，不鉴权，只由前端与宿主 materialize 访问）
REG_AUTHZ_PORT=${REG_AUTHZ_PORT:-18672}                       # d3-registry-authz（鉴权子请求，只绑回环）
REG_IMAGE=${REG_IMAGE:-registry:3.0.0}                        # CNCF distribution v3.0.0（Apache-2.0；本机拉取后 docker save 同步到 dmax）
REG_NGINX_IMAGE=${REG_NGINX_IMAGE:-nginx:1.27-alpine}         # 与 d3-labweb 同一基础镜像（dmax 已有）
REG_AUTHZ_IMAGE=${REG_AUTHZ_IMAGE:-d3-lab-py:$LAB_TAG}        # authz.py 只依赖标准库与 awr.bench（labctl.sh build 构建）
REG_ORIGIN=${REG_ORIGIN:-$REG_BIND:$REG_PORT}                 # docker login / push 使用的仓库地址
REG_DRILL_TAG=${REG_DRILL_TAG:-b25}
TRIVY_CACHE=${TRIVY_CACHE:-/data/anet-drone4d-d3/d3dev/trivy-cache}     # Trivy 离线库（ADR-204，B14 fetch.sh 同步；扫描容器只读挂载）
